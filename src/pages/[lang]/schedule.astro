---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventCard from '../../components/EventCard.astro';
import { localePath } from '../../i18n/utils';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// 過去の出演は最初の数件のみ表示し、残りは「もっと見る」で展開する
const PAST_VISIBLE_COUNT = 5;

const now = new Date();
const allEvents = await getCollection('schedule');
const upcomingEvents = allEvents
  .filter((event) => event.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const pastEvents = allEvents
  .filter((event) => event.data.date < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 構造化データ: 公演イベント（仕様書④-2）
const eventsJsonLd = {
  '@context': 'https://schema.org',
  '@graph': upcomingEvents.map((event) => ({
    '@type': 'MusicEvent',
    name: lang === 'ja' ? event.data.titleJa : event.data.titleEn,
    startDate: event.data.date.toISOString().slice(0, 10),
    location: {
      '@type': 'Place',
      name: lang === 'ja' ? event.data.venueJa : event.data.venueEn,
      address: {
        '@type': 'PostalAddress',
        addressLocality: lang === 'ja' ? event.data.cityJa : event.data.cityEn,
        addressCountry: event.data.country,
      },
    },
    ...(event.data.ticketUrl ? { offers: { '@type': 'Offer', url: event.data.ticketUrl } } : {}),
  })),
};

const pageTitle = lang === 'ja' ? '出演スケジュール' : 'Schedule';
---

<Base lang={lang} subpath="schedule/" title={pageTitle} description={t('meta.schedule')}>
  <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />

  <div class="mx-auto max-w-6xl px-4 py-section sm:px-6">
    <SectionHeading en="Schedule" label={pageTitle} />

    <section>
      <h2 class="mb-2 text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
        {t('schedule.upcoming')}
      </h2>
      {
        upcomingEvents.length > 0 ? (
          upcomingEvents.map((event) => <EventCard event={event} lang={lang} />)
        ) : (
          <div class="space-y-3 py-6" data-reveal>
            <p class="text-muted">{t('home.noUpcoming')}</p>
            <a
              href={`${localePath(lang, 'contact/')}#booking`}
              class="inline-block border-b border-accent pb-1 text-sm tracking-[0.2em] text-accent hover:opacity-70 transition-opacity"
            >
              {t('home.noUpcomingCta')}
            </a>
          </div>
        )
      }
    </section>

    {
      pastEvents.length > 0 && (
        <section class="mt-section" data-past-section>
          <h2 class="mb-2 text-sm tracking-[0.3em] uppercase text-muted" data-reveal>
            {t('schedule.past')}
          </h2>
          {pastEvents.map((event, index) => (
            <div data-past-item class:list={[index >= PAST_VISIBLE_COUNT && 'hidden']}>
              <EventCard event={event} lang={lang} past />
            </div>
          ))}
          {pastEvents.length > PAST_VISIBLE_COUNT && (
            <div class="mt-8 text-center" data-reveal>
              <button
                type="button"
                data-past-more
                class="border-b border-muted pb-1 text-sm tracking-[0.2em] text-muted transition-colors hover:text-accent hover:border-accent"
              >
                {t('schedule.showMore')}（{pastEvents.length - PAST_VISIBLE_COUNT}）→
              </button>
            </div>
          )}
        </section>
      )
    }
  </div>
</Base>
