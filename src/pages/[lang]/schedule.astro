---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import EventCard from '../../components/EventCard.astro';
import { localePath } from '../../i18n/utils';
import { resolveImageUrl } from '../../lib/images';
import { personId } from '../../lib/seo';
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// 過去の出演は最初の数件のみ表示し、残りは「もっと見る」で展開する
const PAST_VISIBLE_COUNT = 5;

const now = new Date();
const allEvents = await getCollection('schedule');
const upcomingEvents = allEvents
  .filter((event) => event.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const pastEvents = allEvents
  .filter((event) => event.data.date < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 構造化データ: 公演イベント（仕様書④-2）。Google のイベントのリッチリザルトの推奨項目まで埋める
const schedulePageUrl = new URL(localePath(lang, 'schedule/'), Astro.site).href;
const eventsJsonLd = {
  '@context': 'https://schema.org',
  '@graph': upcomingEvents.map((event) => {
    const data = event.data;
    const name = lang === 'ja' ? data.titleJa : data.titleEn;
    const venue = lang === 'ja' ? data.venueJa : data.venueEn;
    const city = lang === 'ja' ? data.cityJa : data.cityEn;
    const images = [...data.flyerUrls, ...data.photoUrls].map(
      (url) => new URL(resolveImageUrl(url), Astro.site).href
    );
    const offerUrl = data.ticketUrl ?? data.websiteUrl;
    return {
      '@type': 'MusicEvent',
      name,
      startDate: data.date.toISOString().slice(0, 10),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      description:
        lang === 'ja'
          ? `${name}（${venue}・${city}）。長唄三味線 ${SITE.artistNameJa} 出演。`
          : `${name} at ${venue}, ${city}, featuring nagauta shamisen player ${SITE.artistNameEn}.`,
      url: data.websiteUrl ?? schedulePageUrl,
      ...(images.length > 0 ? { image: images } : {}),
      location: {
        '@type': 'Place',
        name: venue,
        address: {
          '@type': 'PostalAddress',
          addressLocality: city,
          addressCountry: data.country,
        },
      },
      performer: {
        '@type': 'Person',
        '@id': personId(Astro.site),
        name: lang === 'ja' ? SITE.artistNameJa : SITE.artistNameEn,
      },
      ...(offerUrl || data.soldOut
        ? {
            offers: {
              '@type': 'Offer',
              ...(offerUrl ? { url: offerUrl } : {}),
              availability: data.soldOut
                ? 'https://schema.org/SoldOut'
                : 'https://schema.org/InStock',
            },
          }
        : {}),
    };
  }),
};

const pageTitle = lang === 'ja' ? '出演スケジュール' : 'Schedule';
---

<Base lang={lang} subpath="schedule/" title={pageTitle} description={t('meta.schedule')}>
  {
    upcomingEvents.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />
    )
  }

  <PageHero lang={lang} en="Schedule" label={pageTitle} />

  <!-- 区分ジャンプ: 今後 / 過去 の件数を示すタブ風リンク（スクロール位置で固定） -->
  <nav
    class="sticky top-16 z-30 border-b border-line bg-paper/90 backdrop-blur"
    aria-label={lang === 'ja' ? '出演の区分' : 'Schedule sections'}
  >
    <div class="mx-auto flex max-w-6xl gap-6 px-4 sm:px-6">
      <a href="#upcoming" class="hud flex min-h-12 items-center gap-2 text-accent transition-colors hover:text-ink">
        {t('schedule.upcoming')}
        <span class="rounded-full bg-accent px-1.5 text-[9px] leading-4 text-white">{upcomingEvents.length}</span>
      </a>
      {
        pastEvents.length > 0 && (
          <a href="#past" class="hud flex min-h-12 items-center gap-2 text-muted transition-colors hover:text-ink">
            {t('schedule.past')}
            <span class="rounded-full bg-line px-1.5 text-[9px] leading-4 text-ink/70">{pastEvents.length}</span>
          </a>
        )
      }
    </div>
  </nav>

  <div class="mx-auto max-w-6xl px-4 py-section sm:px-6">
    <section id="upcoming" class="scroll-mt-32">
      <h2 class="hud mb-4 text-accent" data-reveal>
        {t('schedule.upcoming')}
      </h2>
      {
        upcomingEvents.length > 0 ? (
          <div class="border-t border-line">
            {upcomingEvents.map((event, index) => (
              <EventCard event={event} lang={lang} next={index === 0} />
            ))}
          </div>
        ) : (
          <div
            class="flex flex-col items-start gap-4 border border-dashed border-accent/30 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
            data-reveal
          >
            <p class="text-ink/75">{t('home.noUpcoming')}</p>
            <a
              href={`${localePath(lang, 'contact/')}#booking`}
              class="border-b border-accent pb-1 text-sm tracking-[0.2em] text-accent transition-opacity hover:opacity-70"
            >
              {t('home.noUpcomingCta')}
            </a>
          </div>
        )
      }
    </section>

    {
      pastEvents.length > 0 && (
        <section id="past" class="mt-section scroll-mt-32" data-past-section>
          <h2 class="hud mb-4 text-muted" data-reveal>
            {t('schedule.past')}
          </h2>
          <div class="border-t border-line">
          {pastEvents.map((event, index) => (
            <div data-past-item class:list={[index >= PAST_VISIBLE_COUNT && 'hidden']}>
              <EventCard event={event} lang={lang} past />
            </div>
          ))}
          </div>
          {pastEvents.length > PAST_VISIBLE_COUNT && (
            <div class="mt-8 text-center" data-reveal>
              <button
                type="button"
                data-past-more
                class="border-b border-muted pb-1 text-sm tracking-[0.2em] text-muted transition-colors hover:text-accent hover:border-accent"
              >
                {t('schedule.showMore')}（{pastEvents.length - PAST_VISIBLE_COUNT}）→
              </button>
            </div>
          )}
        </section>
      )
    }
  </div>
</Base>
