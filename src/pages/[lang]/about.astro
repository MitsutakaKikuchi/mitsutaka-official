---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PageHero from '../../components/PageHero.astro';
import { localePath } from '../../i18n/utils';
import { buildPerson, websiteId } from '../../lib/seo';
import portraitPhoto from '../../assets/photos/portrait.jpg';
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const profile = {
  ja: [
    '東京都出身。',
    '幼少より父 若柳宏晃に日本舞踊の手ほどきを受け、直派分家若柳流へ入門。若柳歓峰の名を許される。',
    '長唄三味線を成田涼子氏に師事。',
    '長唄・三味線の演奏会・舞踊会への出演の他、東京都台東区立浅草中学校三味線部の指導を務める等、学校教育における和楽器指導へも尽力。',
    '現在、東京藝術大学音楽学部邦楽科に在学中。',
  ],
  en: [
    'Born in Tokyo.',
    'He took up classical Japanese dance (nihon buyo) as a child under his father, Wakayagi Hiroteru (若柳宏晃), later joining the Jikiha Bunke branch of the Wakayagi school, where he was granted the stage name Wakayagi Yoshitaka (若柳歓峰).',
    'On the shamisen, he studies nagauta under Narita Ryoko (成田涼子).',
    'Alongside performing in nagauta concerts and dance recitals, he is devoted to music education, serving as instructor for the shamisen club at Asakusa Junior High School in Taito City, Tokyo.',
    'He is currently enrolled in the Department of Traditional Japanese Music at the Tokyo University of the Arts.',
  ],
} as const;

const pageTitle = lang === 'ja' ? 'プロフィール' : 'About';

// 構造化データ: プロフィールページ（ProfilePage）。主題となる人物を明示する
const portraitImage = await getImage({ src: portraitPhoto, width: 800, format: 'jpg' });
const profilePageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: `${pageTitle} | ${lang === 'ja' ? SITE.artistNameJa : SITE.artistNameEn}`,
  url: new URL(localePath(lang, 'about/'), Astro.site).href,
  inLanguage: lang,
  isPartOf: { '@id': websiteId(Astro.site) },
  mainEntity: buildPerson(lang, Astro.site, new URL(portraitImage.src, Astro.site).href),
};
---

<Base lang={lang} subpath="about/" title={pageTitle} description={t('meta.about')}>
  <script type="application/ld+json" set:html={JSON.stringify(profilePageJsonLd)} />
  <PageHero lang={lang} en="About" label={pageTitle} />
  <div class="mx-auto max-w-6xl px-4 py-section sm:px-6">

    <div class="grid gap-12 md:grid-cols-[1fr_minmax(16rem,24rem)]">
      <div class="space-y-6 leading-loose" data-reveal>
        <p class="font-serif text-lead tracking-[0.2em]">
          {lang === 'ja' ? SITE.artistNameJa : SITE.artistNameEn}
          <span class="ml-4 align-middle text-xs tracking-[0.3em] text-muted">
            {lang === 'ja' ? SITE.artistNameDisplay : SITE.artistNameJa}
          </span>
        </p>
        {/* 経歴は番号を付けず、左に一本の縦罫を添えた散文として組む */}
        <div class="space-y-5 border-l border-line pl-6">
          {profile[lang].map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <figure class="relative m-3 self-start md:sticky md:top-24">
        <span class="hud-corners text-accent/50" aria-hidden="true"></span>
        <div class="relative overflow-hidden" data-mask-reveal data-scan>
        <Image
          src={portraitPhoto}
          alt={lang === 'ja' ? '長唄三味線方・菊池光峰のポートレート写真' : 'Portrait photograph of nagauta shamisen player KIKUCHI Mitsutaka'}
          widths={[400, 800]}
          sizes="(min-width: 768px) 24rem, 90vw"
          class="w-full object-cover"
          loading="eager"
        />
        </div>
        <figcaption class="hud mt-3 flex justify-between text-muted">
          <span>Portrait</span>
          <span>{lang === 'ja' ? SITE.artistNameDisplay : SITE.artistNameJa}</span>
        </figcaption>
      </figure>
    </div>

    <!-- TODO: 受賞歴・主な実績が確定したらセクションとして追加する -->

    <section class="mt-section">
      <SectionHeading en="Press Kit" label={lang === 'ja' ? 'プレス向け資料' : 'Press Kit'} />
      <div class="flex flex-col items-start gap-6 border border-line bg-white/50 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8" data-reveal>
      <p class="max-w-2xl leading-relaxed text-ink/75">
        {
          lang === 'ja'
            ? '高解像度の宣材写真・プロフィール文（日英）をご用意しています。お問い合わせフォームよりご請求ください。'
            : 'High-resolution photos and an official biography (Japanese / English) are available upon request via the contact form.'
        }
      </p>
      <a
        href={`${localePath(lang, 'contact/')}?type=press#booking`}
        class="btn-cta shrink-0 bg-accent px-6 py-3 text-xs tracking-[0.25em] text-white hover:bg-accent-dark"
      >
        {lang === 'ja' ? '資料を請求する' : 'Request press kit'}
      </a>
      </div>
    </section>
  </div>
</Base>
