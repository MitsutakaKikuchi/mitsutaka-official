---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import portraitPhoto from '../../assets/photos/portrait.jpg';
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const profile = {
  ja: [
    '東京都出身。',
    '幼少より父 若柳宏晃に日本舞踊の手ほどきを受け、直派分家若柳流へ入門。若柳歓峰の名を許される。',
    '長唄三味線を成田涼子氏に師事。',
    '長唄・三味線の演奏会・舞踊会への出演の他、東京都台東区立浅草中学校三味線部の指導を務める等、学校教育における和楽器指導へも尽力。',
    '現在、東京藝術大学音楽学部邦楽科に在学中。',
  ],
  en: [
    'Born in Tokyo.',
    'He took up classical Japanese dance (nihon buyo) as a child under his father, Wakayagi Hiroteru (若柳宏晃), later joining the Jikiha Bunke branch of the Wakayagi school, where he was granted the stage name Wakayagi Yoshitaka (若柳歓峰).',
    'On the shamisen, he studies nagauta under Narita Ryoko (成田涼子).',
    'Alongside performing in nagauta concerts and dance recitals, he is devoted to music education, serving as instructor for the shamisen club at Asakusa Junior High School in Taito City, Tokyo.',
    'He is currently enrolled in the Department of Traditional Japanese Music at the Tokyo University of the Arts.',
  ],
} as const;

const pageTitle = lang === 'ja' ? 'プロフィール' : 'About';
---

<Base lang={lang} subpath="about/" title={pageTitle} description={t('meta.about')}>
  <div class="mx-auto max-w-6xl px-4 py-section sm:px-6">
    <SectionHeading en="About" label={pageTitle} />

    <div class="grid gap-12 md:grid-cols-[1fr_minmax(16rem,24rem)]">
      <div class="space-y-6 leading-loose" data-reveal>
        <p class="font-serif text-lead tracking-[0.2em]">
          {lang === 'ja' ? SITE.artistNameJa : SITE.artistNameEn}
          <span class="ml-4 align-middle text-xs tracking-[0.3em] text-muted">
            {lang === 'ja' ? SITE.artistNameDisplay : SITE.artistNameJa}
          </span>
        </p>
        {profile[lang].map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <figure class="self-start" data-mask-reveal>
        <Image
          src={portraitPhoto}
          alt={lang === 'ja' ? '菊池光峰 ポートレート' : 'Portrait of KIKUCHI Mitsutaka'}
          widths={[400, 800]}
          sizes="(min-width: 768px) 24rem, 90vw"
          class="w-full object-cover"
          loading="eager"
        />
      </figure>
    </div>

    <!-- TODO: 受賞歴・主な実績が確定したらセクションとして追加する -->

    <section class="mt-section">
      <SectionHeading en="Press Kit" label={lang === 'ja' ? 'プレス向け資料' : 'Press Kit'} />
      <p class="leading-relaxed text-muted" data-reveal>
        {
          lang === 'ja'
            ? '高解像度の宣材写真・プロフィール文（日英）をご用意しています。お問い合わせフォームよりご請求ください。'
            : 'High-resolution photos and an official biography (Japanese / English) are available upon request via the contact form.'
        }
      </p>
    </section>
  </div>
</Base>
