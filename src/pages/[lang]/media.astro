---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import performancePhoto from '../../assets/photos/performance.jpg';
import concertPhoto from '../../assets/photos/concert-ensemble.jpg';
import workshopPhoto from '../../assets/photos/workshop.jpg';
import rehearsalPhoto from '../../assets/photos/rehearsal.jpg';
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const photos = [
  { src: performancePhoto, ja: '各種演奏会', en: 'Concerts' },
  { src: concertPhoto, ja: 'イベント等での共演ステージ', en: 'Collaborative performances' },
  { src: workshopPhoto, ja: 'レクチャー・ワークショップ', en: 'Lectures & workshops' },
  { src: rehearsalPhoto, ja: 'レコーディング', en: 'Recording sessions' },
] as const;

// 動画IDが未登録（空文字のみ）の場合は動画セクションを表示しない
const videoIds = SITE.youtubeVideoIds.filter(Boolean);

const pageTitle = lang === 'ja' ? 'メディア' : 'Media';
---

<Base lang={lang} subpath="media/" title={pageTitle} description={t('meta.media')}>
  <div class="mx-auto max-w-6xl px-4 py-section sm:px-6">
    <SectionHeading en="Media" label={pageTitle} />

    {
      videoIds.length > 0 && (
        <section>
          <h2 class="mb-6 text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
            {t('media.videos')}
          </h2>
          <div class="grid gap-8 md:grid-cols-2" data-reveal>
            {videoIds.map((videoId) => (
              <YouTubeEmbed videoId={videoId} title={`${SITE.artistNameEn} — Performance`} />
            ))}
          </div>
        </section>
      )
    }

    <section class:list={[videoIds.length > 0 && 'mt-section']}>
      <h2 class="mb-6 text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
        {t('media.gallery')}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          photos.map((photo) => (
            <figure class="group" data-mask-reveal>
              <div class="relative overflow-hidden">
                <Image
                  src={photo.src}
                  alt={lang === 'ja' ? photo.ja : photo.en}
                  widths={[480, 960]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                {/* ホバー時に内側へ朱の額縁が浮かび上がる（ヒーローの額装モチーフと呼応）。装飾のみ・即revert可 */}
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-2.5 border border-vermilion/0 transition-colors duration-500 group-hover:border-vermilion/50"
                ></span>
              </div>
              <figcaption class="px-1 py-3 text-xs tracking-[0.2em] text-muted">
                {lang === 'ja' ? photo.ja : photo.en}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>
  </div>
</Base>
