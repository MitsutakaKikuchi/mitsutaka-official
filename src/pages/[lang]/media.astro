---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const GALLERY_PLACEHOLDER_COUNT = 6;
const pageTitle = lang === 'ja' ? 'メディア' : 'Media';
---

<Base lang={lang} subpath="media/" title={pageTitle}>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <SectionHeading en="Media" label={pageTitle} />

    <section>
      <h2 class="mb-6 text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
        {t('media.videos')}
      </h2>
      <div class="grid gap-8 md:grid-cols-2" data-reveal>
        {
          SITE.youtubeVideoIds.map((videoId) => (
            <YouTubeEmbed videoId={videoId} title={`${SITE.artistNameEn} — Performance`} />
          ))
        }
      </div>
    </section>

    <section class="mt-20">
      <h2 class="mb-6 text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
        {t('media.gallery')}
      </h2>
      <!-- 撮影素材が揃ったら <img loading="lazy"> に差し替えるプレースホルダーグリッド -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3" data-reveal>
        {
          Array.from({ length: GALLERY_PLACEHOLDER_COUNT }, (_, index) => (
            <div class="flex aspect-square items-center justify-center border border-line bg-white/60 text-xs tracking-widest text-muted">
              {lang === 'ja' ? `写真 ${index + 1}（準備中）` : `Photo ${index + 1} (soon)`}
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>
