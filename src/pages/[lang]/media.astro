---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import performancePhoto from '../../assets/photos/performance.jpg';
import concertPhoto from '../../assets/photos/concert-ensemble.jpg';
import workshopPhoto from '../../assets/photos/workshop.jpg';
import rehearsalPhoto from '../../assets/photos/rehearsal.jpg';
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// caption はギャラリーの見出し、alt は写真の内容を説明する代替テキスト（アクセシビリティ・画像検索用）
const photos = [
  {
    src: performancePhoto,
    ja: '各種演奏会',
    en: 'Concerts',
    altJa: '演奏会の舞台で紋付を着て長唄三味線を演奏する菊池光峰',
    altEn: 'KIKUCHI Mitsutaka in formal kimono playing nagauta shamisen on a concert stage',
  },
  {
    src: concertPhoto,
    ja: 'イベント等での共演ステージ',
    en: 'Collaborative performances',
    altJa: '共演者と並んで舞台で三味線を演奏する菊池光峰',
    altEn: 'KIKUCHI Mitsutaka performing shamisen on stage alongside fellow musicians',
  },
  {
    src: workshopPhoto,
    ja: 'レクチャー・ワークショップ',
    en: 'Lectures & workshops',
    altJa: 'ワークショップで参加者に三味線の演奏を教える菊池光峰',
    altEn: 'KIKUCHI Mitsutaka teaching shamisen to participants at a workshop',
  },
  {
    src: rehearsalPhoto,
    ja: 'レコーディング',
    en: 'Recording sessions',
    altJa: 'レコーディングスタジオで三味線を演奏する菊池光峰',
    altEn: 'KIKUCHI Mitsutaka playing shamisen during a recording session',
  },
] as const;

// ライトボックス用の大きめの画像（WebP 1600px）
const largeUrls = await Promise.all(
  photos.map(async (photo) => (await getImage({ src: photo.src, width: 1600, format: 'webp' })).src)
);
const altList = photos.map((photo) => (lang === 'ja' ? photo.altJa : photo.altEn));

// 動画IDが未登録（空文字のみ）の場合は動画セクションを表示しない
const videoIds = SITE.youtubeVideoIds.filter(Boolean);

const pageTitle = lang === 'ja' ? 'メディア' : 'Media';
---

<Base lang={lang} subpath="media/" title={pageTitle} description={t('meta.media')}>
  <PageHero lang={lang} en="Media" label={pageTitle} index={3} />
  <div class="mx-auto max-w-6xl px-4 py-section sm:px-6">

    {
      videoIds.length > 0 && (
        <section>
          <h2 class="hud mb-6 text-accent" data-reveal>
            {t('media.videos')}
          </h2>
          <div class="grid gap-8 md:grid-cols-2" data-reveal>
            {videoIds.map((videoId) => (
              <YouTubeEmbed videoId={videoId} title={`${SITE.artistNameEn} — Performance`} />
            ))}
          </div>
        </section>
      )
    }

    <section class:list={[videoIds.length > 0 && 'mt-section']}>
      <h2 class="hud mb-6 text-accent" data-reveal>
        {t('media.gallery')}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          photos.map((photo, index) => (
            <figure class="group" data-mask-reveal>
              {/* 写真をタップ／クリックすると拡大表示（← → / スワイプで前後の写真へ） */}
              <button
                type="button"
                class="relative block w-full cursor-zoom-in overflow-hidden text-left"
                data-lightbox
                data-images={JSON.stringify(largeUrls)}
                data-alts={JSON.stringify(altList)}
                data-start={index}
                aria-label={`${lang === 'ja' ? '拡大表示' : 'Enlarge'}: ${lang === 'ja' ? photo.ja : photo.en}`}
              >
                <Image
                  src={photo.src}
                  alt={lang === 'ja' ? photo.altJa : photo.altEn}
                  widths={[480, 960]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                {/* ホバー時に内側へ朱の額縁が浮かび上がる（ヒーローの額装モチーフと呼応） */}
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-2.5 border border-vermilion/0 transition-colors duration-500 group-hover:border-vermilion/50"
                ></span>
                <span
                  aria-hidden="true"
                  class="absolute right-3 bottom-3 flex h-8 w-8 items-center justify-center bg-ink/60 text-paper opacity-80 transition-opacity group-hover:opacity-100"
                >
                  <svg viewBox="0 0 16 16" class="h-3.5 w-3.5">
                    <path d="M9.5 2.5h4v4M6.5 13.5h-4v-4M13.5 2.5 9 7M2.5 13.5 7 9" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                  </svg>
                </span>
              </button>
              <figcaption class="flex items-baseline justify-between gap-4 px-1 py-3">
                <span class="text-xs tracking-[0.2em] text-ink/75">{lang === 'ja' ? photo.ja : photo.en}</span>
                <span class="hud text-muted">Fig. {String(index + 1).padStart(2, '0')}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>
  </div>
</Base>
