---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE } from '../../config/site';
import { localePath } from '../../i18n/utils';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const pageTitle = lang === 'ja' ? 'お問い合わせ' : 'Contact';
// text-base（16px）でモバイルの iOS 自動ズームを防ぎ、PC では sm:text-sm に戻す
const inputClass =
  'peer w-full border border-line bg-white/70 px-4 py-3 text-base tracking-wider transition-colors focus:border-accent focus:outline-none aria-[invalid=true]:border-vermilion sm:text-sm';
const labelClass = 'mb-2 block text-xs tracking-[0.25em] uppercase text-accent';
const errorClass = 'form-error mt-2 hidden text-xs tracking-wider text-vermilion';

const thanksUrl = localePath(lang, 'thanks/');
---

<Base
  lang={lang}
  subpath="contact/"
  title={pageTitle}
  description={t('meta.contact')}
  hideStickyCta
>
  <div class="mx-auto max-w-3xl px-4 py-section sm:px-6">
    <SectionHeading en="Contact / Booking" label={pageTitle} id="booking" />

    <p class="leading-relaxed text-muted" data-reveal>{t('contact.lead')}</p>

    <!--
      Formspree による静的サイト用フォーム。
      JS 有効時は fetch で送信し、成功したら /thanks/ へ遷移する（送信中・エラー表示付き）。
      JS 無効時は通常の POST として送られ、Formspree 側の完了画面が表示される。
    -->
    <form
      id="contact-form"
      action={SITE.formspreeEndpoint}
      method="POST"
      class="mt-12 space-y-8"
      data-thanks={thanksUrl}
      data-msg-required={t('form.errorRequired')}
      data-msg-email={t('form.errorEmail')}
      data-msg-summary={t('form.errorSummary')}
      data-msg-network={t('form.errorNetwork')}
      data-msg-server={t('form.errorServer')}
      data-msg-sending={t('form.sending')}
      data-reveal
      novalidate
    >
      <input type="hidden" name="_language" value={lang} />
      <input type="hidden" name="_subject" value={`[${SITE.artistNameEn} Web] ${pageTitle}`} />
      {/* ボット対策のハニーポット（人間には見えない。値が入っていれば Formspree が破棄する） */}
      <p class="hidden" aria-hidden="true">
        <label>
          Leave this field empty
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <fieldset>
        <legend class={labelClass}>{t('contact.type')}</legend>
        <div class="flex flex-col gap-3 sm:flex-row sm:gap-6">
          {
            [
              { value: 'booking', label: t('contact.typeBooking') },
              { value: 'general', label: t('contact.typeGeneral') },
              { value: 'press', label: t('contact.typePress') },
            ].map((option, index) => (
              <label class="flex min-h-11 items-center gap-2 text-sm tracking-wider">
                <input
                  type="radio"
                  name="inquiryType"
                  value={option.value}
                  checked={index === 0}
                  class="h-4 w-4 accent-accent"
                />
                {option.label}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <label for="field-name" class={labelClass}>{t('contact.name')} *</label>
          <input
            id="field-name"
            type="text"
            name="name"
            required
            autocomplete="name"
            class={inputClass}
            aria-describedby="error-name"
          />
          <p id="error-name" class={errorClass} role="alert"></p>
        </div>
        <div>
          <label for="field-email" class={labelClass}>{t('contact.email')} *</label>
          <input
            id="field-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
            class={inputClass}
            aria-describedby="error-email"
          />
          <p id="error-email" class={errorClass} role="alert"></p>
        </div>
      </div>

      <div>
        <label for="field-org" class={labelClass}>{t('contact.org')}</label>
        <input
          id="field-org"
          type="text"
          name="organization"
          autocomplete="organization"
          class={inputClass}
        />
      </div>

      <div>
        <label for="field-message" class={labelClass}>{t('contact.message')} *</label>
        <textarea
          id="field-message"
          name="message"
          required
          rows={8}
          placeholder={t('contact.messagePlaceholder')}
          class={inputClass}
          aria-describedby="error-message"></textarea>
        <p id="error-message" class={errorClass} role="alert"></p>
      </div>

      <div>
        <label class="flex min-h-11 items-start gap-3 text-sm leading-relaxed tracking-wider">
          <input
            id="field-consent"
            type="checkbox"
            name="privacyConsent"
            value="yes"
            required
            class="mt-1 h-4 w-4 shrink-0 accent-accent"
            aria-describedby="error-consent"
          />
          <span>
            {t('form.privacyConsent')}
            <a
              href={localePath(lang, 'privacy/')}
              target="_blank"
              rel="noopener"
              class="ml-2 border-b border-accent/50 text-xs tracking-[0.2em] text-accent hover:opacity-70 transition-opacity"
            >
              {t('form.privacyLink')} ↗
            </a>
          </span>
        </label>
        <p id="error-consent" class={errorClass} role="alert"></p>
      </div>

      {/* 送信全体のエラー（通信失敗・サーバーエラー・入力不備の要約） */}
      <div
        id="form-status"
        class="hidden border-l-2 border-vermilion bg-vermilion/[0.06] px-4 py-3 text-sm leading-relaxed text-ink/85"
        role="alert"
        aria-live="assertive"
      >
      </div>

      <button
        type="submit"
        class="btn-cta bg-accent hover:bg-accent-dark relative w-full px-10 py-4 text-sm tracking-[0.25em] text-white disabled:cursor-wait disabled:opacity-80 sm:w-auto"
        data-magnetic
      >
        <span class="btn-label">{t('contact.submit')}</span>
        <span class="btn-spinner" aria-hidden="true"></span>
      </button>
    </form>

    <p class="mt-8 text-xs leading-relaxed text-muted" data-reveal>{t('contact.note')}</p>
  </div>
</Base>

<script>
  /**
   * フォームの送信制御。
   * 1. 送信前にクライアント側で必須・メール形式を検証し、項目ごとにエラーを表示
   * 2. fetch で Formspree に JSON 送信。送信中はボタンを無効化してスピナー表示
   * 3. 成功 → ありがとうページへ遷移。失敗 → 種別に応じたエラーメッセージを表示
   */
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setFieldError(form: HTMLFormElement, name: string, message: string | null): void {
    const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
    const errorEl = form.querySelector<HTMLElement>(`#error-${name === 'privacyConsent' ? 'consent' : name}`);
    if (!field || !errorEl) return;
    field.setAttribute('aria-invalid', message ? 'true' : 'false');
    errorEl.textContent = message ?? '';
    errorEl.classList.toggle('hidden', !message);
    errorEl.classList.toggle('is-visible', Boolean(message));
  }

  function validate(form: HTMLFormElement): boolean {
    const msgRequired = form.dataset.msgRequired ?? '';
    const msgEmail = form.dataset.msgEmail ?? '';
    let firstInvalid: HTMLElement | null = null;

    const check = (name: string, valid: boolean, message: string) => {
      setFieldError(form, name, valid ? null : message);
      if (!valid && !firstInvalid) {
        firstInvalid = form.elements.namedItem(name) as HTMLElement | null;
      }
    };

    const nameField = form.elements.namedItem('name') as HTMLInputElement;
    const emailField = form.elements.namedItem('email') as HTMLInputElement;
    const messageField = form.elements.namedItem('message') as HTMLTextAreaElement;
    const consentField = form.elements.namedItem('privacyConsent') as HTMLInputElement;

    check('name', nameField.value.trim().length > 0, msgRequired);
    const emailValue = emailField.value.trim();
    check('email', emailValue.length > 0 && EMAIL_PATTERN.test(emailValue), emailValue ? msgEmail : msgRequired);
    check('message', messageField.value.trim().length > 0, msgRequired);
    check('privacyConsent', consentField.checked, msgRequired);

    if (firstInvalid) {
      (firstInvalid as HTMLElement).focus({ preventScroll: false });
      return false;
    }
    return true;
  }

  function showStatus(form: HTMLFormElement, message: string | null): void {
    const status = form.querySelector<HTMLElement>('#form-status');
    if (!status) return;
    status.textContent = message ?? '';
    status.classList.toggle('hidden', !message);
  }

  function setSubmitting(form: HTMLFormElement, submitting: boolean): void {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!button) return;
    button.disabled = submitting;
    button.classList.toggle('is-loading', submitting);
    button.setAttribute('aria-busy', String(submitting));
    const label = button.querySelector<HTMLElement>('.btn-label');
    if (label) {
      label.dataset.original ??= label.textContent ?? '';
      label.textContent = submitting ? (form.dataset.msgSending ?? '') : label.dataset.original;
    }
  }

  function bindContactForm(): void {
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    // 入力し直したらその項目のエラーを消す
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[aria-describedby]').forEach((field) => {
      field.addEventListener('input', () => setFieldError(form, field.name, null));
      field.addEventListener('change', () => setFieldError(form, field.name, null));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showStatus(form, null);
      if (!validate(form)) {
        showStatus(form, form.dataset.msgSummary ?? null);
        return;
      }

      setSubmitting(form, true);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          window.location.assign(form.dataset.thanks ?? '/');
          return;
        }
        // Formspree は 4xx の場合 { errors: [{ field, message }] } を返す
        let handled = false;
        try {
          const data = (await response.json()) as { errors?: { field?: string; message?: string }[] };
          data.errors?.forEach((error) => {
            if (error.field && error.message) {
              setFieldError(form, error.field, error.message);
              handled = true;
            }
          });
        } catch {
          /* JSON でない応答はサーバーエラーとして扱う */
        }
        showStatus(form, handled ? (form.dataset.msgSummary ?? null) : (form.dataset.msgServer ?? null));
      } catch {
        showStatus(form, form.dataset.msgNetwork ?? null);
      } finally {
        setSubmitting(form, false);
      }
    });
  }

  document.addEventListener('astro:page-load', bindContactForm);
</script>
