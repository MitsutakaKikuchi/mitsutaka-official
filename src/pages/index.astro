---
import { localePath } from '../i18n/utils';
import { SITE } from '../config/site';

// ルートアクセス時はブラウザ言語に応じて /ja/ または /en/ へ振り分ける
const jaUrl = localePath('ja');
const enUrl = localePath('en');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>{SITE.artistNameEn}</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${jaUrl}`} />
    </noscript>
    <script is:inline define:vars={{ jaUrl, enUrl }}>
      const prefersJapanese = navigator.language.toLowerCase().startsWith('ja');
      location.replace(prefersJapanese ? jaUrl : enUrl);
    </script>
  </head>
  <body
    style="margin:0;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.75rem;background:#f7f5f0;color:#1a1a1a;font-family:'Cormorant Garamond',serif;"
  >
    <p
      style="margin:0;font-size:1.35rem;letter-spacing:0.35em;text-indent:0.35em;font-family:serif;"
    >
      {SITE.artistNameJa}
    </p>
    <p
      style="margin:0;font-size:0.7rem;letter-spacing:0.3em;text-transform:uppercase;color:#8a8580;"
    >
      {SITE.artistNameEn}
    </p>
    <p style="margin:0;display:flex;gap:1.25rem;font-size:0.8rem;letter-spacing:0.2em;">
      <a href={jaUrl} style="color:#1b3a5b;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px;">日本語</a>
      <a href={enUrl} style="color:#1b3a5b;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px;">English</a>
    </p>
  </body>
</html>
