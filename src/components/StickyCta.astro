---
/**
 * スマホ専用のスティッキー CTA（画面下部に固定）。
 * ファーストビューを過ぎたら現れ、フッターに達すると引っ込む（JS: effects.ts initStickyCta）。
 * お問い合わせページでは表示しない（フォーム自体が CTA のため）。
 */
import { localePath } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-[55] md:hidden"
  aria-hidden="true"
>
  <div
    class="theme-night mx-3 mb-3 flex items-stretch gap-2 border border-paper/10 !bg-night/85 p-2 shadow-[0_10px_30px_rgb(11_15_22/0.35)] backdrop-blur-md"
    style="margin-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));"
  >
    <a
      href={localePath(lang, 'schedule/')}
      class="flex min-h-11 flex-1 items-center justify-center border border-paper/20 px-3 py-3 text-xs tracking-[0.25em] text-paper/85 transition-colors active:bg-paper/10"
      tabindex="-1"
    >
      {t('sticky.schedule')}
    </a>
    <a
      href={`${localePath(lang, 'contact/')}#booking`}
      class="btn-cta btn-light relative flex min-h-11 flex-[1.4] items-center justify-center overflow-hidden px-3 py-3 text-xs tracking-[0.25em]"
      tabindex="-1"
    >
      <span class="relative z-10">{t('sticky.cta')}</span>
      {/* 撥で弦を弾いたような朱の光が右から左へ走る（reduced-motion では停止） */}
      <span aria-hidden="true" class="cta-sheen"></span>
    </a>
  </div>
</div>
