---
/**
 * 下層ページの冒頭「夜の舞台」帯。
 * - ページの h1（下層ページには従来 h1 が無かったため、見出し構造の改善も兼ねる）
 * - パンくず（ホーム / 現在ページ）と、ページ番号の HUD
 * - 背景に大きな欧文の透かしと、触れると鳴る光の三本弦
 * 下端の光の筋（night-seam）を境に、本文の「昼の和紙」へ切り替わる。
 */
import Strings from './Strings.astro';
import StringsHud from './StringsHud.astro';
import { localePath } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 欧文の見出し（例: Schedule） */
  en: string;
  /** 表示言語での見出し（h1） */
  label: string;
  /** ナビゲーション上の順番（01〜04）。省略時は非表示 */
  index?: number;
  /** 見出し下のリード文（任意） */
  lead?: string;
}

const { lang, en, label, index, lead } = Astro.props;
const t = useTranslations(lang);
const NAV_TOTAL = 4;
const indexLabel =
  index !== undefined
    ? `${String(index).padStart(2, '0')} / ${String(NAV_TOTAL).padStart(2, '0')}`
    : null;
---

<section
  class="theme-night night-sky relative overflow-hidden pt-16"
  data-theme="night"
  data-strings-host
>
  <!-- 背景の欧文透かし（装飾） -->
  <p
    class="pointer-events-none absolute -bottom-[0.18em] right-[-0.04em] select-none font-display text-[clamp(5rem,2rem+14vw,15rem)] leading-none tracking-[0.04em] text-paper/[0.04]"
    aria-hidden="true"
  >
    {en}
  </p>

  <Strings angle={-6} baseY={300} gap={14} viewHeight={400} />

  <div class="relative mx-auto max-w-6xl px-4 pt-12 pb-16 sm:px-6 sm:pt-16 sm:pb-20">
    <nav aria-label={lang === 'ja' ? 'パンくずリスト' : 'Breadcrumb'} class="hud text-paper/45" data-reveal>
      <ol class="flex items-center gap-2">
        <li>
          <a href={localePath(lang)} class="transition-colors hover:text-paper">{t('breadcrumb.home')}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-paper/75">{label}</li>
      </ol>
    </nav>

    <div class="mt-10 flex flex-col gap-4 sm:mt-14" data-reveal>
      <p class="hud flex items-center gap-3 text-glow">
        {indexLabel && <span class="text-vermilion">{indexLabel}</span>}
        {en !== label && <span>{en}</span>}
        <span class="heading-rule h-px w-12 bg-glow/50" aria-hidden="true"></span>
      </p>
      <h1 class="font-display text-[clamp(2.25rem,1.6rem+3vw,3.75rem)] leading-tight tracking-[0.14em] text-paper">
        {label}
      </h1>
      {lead && <p class="max-w-2xl leading-relaxed text-paper/70">{lead}</p>}
    </div>

    <StringsHud lang={lang} class="mt-12 sm:absolute sm:right-6 sm:bottom-8 sm:mt-0 sm:items-end" />
  </div>

  <span class="night-seam" aria-hidden="true"></span>
</section>
