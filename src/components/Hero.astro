---
import { Image } from 'astro:assets';
import performancePhoto from '../assets/photos/performance.jpg';
import { SITE } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// キネティック・タイポグラフィ用に1文字ずつ分割（GSAP がステージング表示する）
const catchChars = [...t('hero.catchcopy')];
---

<section
  class="relative flex min-h-[calc(100svh-4rem)] items-center justify-center overflow-hidden"
>
  <!-- WebGL パーティクル（墨を流したような藍の粒子・マウス反応。reduced-motion 時は起動しない） -->
  <canvas
    id="hero-canvas"
    class="pointer-events-none absolute inset-0 h-full w-full"
    aria-hidden="true"></canvas>

  <!-- 円相（禅画の一円相）をモチーフにした SVG ラインドローイング。
       ページ表示時に筆で一筆書きされるように現れ、描き終えると静かに「呼吸」する。 -->
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1200 800"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <!--
      一円相（いちえんそう）: 筆で一気に描いた墨の円。
      data-draw で一筆書きされ、hero-ensou によりごく僅かに拡縮・濃淡が揺らぐ（回転はしない）。
    -->
    <circle
      class="hero-ensou"
      data-draw
      cx="420"
      cy="400"
      r="300"
      fill="none"
      stroke="#1b3a5b"
      stroke-opacity="0.16"
      stroke-width="2"
      stroke-linecap="round"></circle>
    <!-- 界線（けいせん）: 一本の細い斜線を筆で引く -->
    <line
      data-draw
      x1="150"
      y1="700"
      x2="1050"
      y2="60"
      stroke="#1a1a1a"
      stroke-opacity="0.06"
      stroke-width="1"></line>
  </svg>

  <!-- pb はスクロールインジケーター（absolute bottom）との重なりを防ぐ余白 -->
  <!-- hero-fade: スクロール退場時にフェード＋上昇する CSS スクロール駆動演出 -->
  <div
    class="hero-fade relative mx-auto grid w-full max-w-6xl items-center justify-items-center gap-12 px-4 pt-10 pb-28 sm:px-6 sm:pb-32 md:grid-cols-[1fr_auto]"
  >
    {
      lang === 'ja' ? (
        <div class="flex flex-col items-center gap-8">
          {/* 縦書き: 右のキャッチコピー → 左の名前 の順に読む */}
          <div class="flex flex-row-reverse items-start justify-center gap-8 sm:gap-12">
            <h1 class="vertical-text max-h-[min(34rem,calc(100svh-18rem))] font-serif text-lead leading-loose tracking-[0.42em] text-ink/80">
              {catchChars.map((char) => (
                <span class="k-char">{char}</span>
              ))}
              <span class="sr-only">{SITE.artistNameJa}</span>
            </h1>
            <div class="flex flex-row-reverse items-start gap-5" data-reveal>
              <p class="vertical-text text-xs tracking-[0.5em] text-accent sm:text-sm">
                {t('hero.sub')}
              </p>
              <p
                class="vertical-text font-display text-display tracking-[0.3em]"
                aria-hidden="true"
              >
                {SITE.artistNameJa}
              </p>
            </div>
          </div>
          <p class="text-[10px] tracking-[0.5em] text-muted" data-reveal>
            {SITE.artistNameDisplay}
          </p>
        </div>
      ) : (
        <div class="flex flex-col gap-6">
          {/* 単語ごとに inline-block + whitespace-nowrap で包み、単語間は実スペースで分かち書き。
              これにより 1 文字ずつのアニメ（.k-char）を保ちつつ、語の途中で改行されず
              スペースも潰れない（inline-block の連続で空白が消える問題を回避）。 */}
          <h1 class="font-serif text-headline tracking-[0.1em]">
            {t('hero.catchcopy')
              .split(' ')
              .map((word, wordIndex) => (
                <>
                  {wordIndex > 0 && ' '}
                  <span class="inline-block whitespace-nowrap">
                    {[...word].map((char) => (
                      <span class="k-char">{char}</span>
                    ))}
                  </span>
                </>
              ))}
            <span class="sr-only">{SITE.artistNameEn}</span>
          </h1>
          <div class="flex flex-col gap-2" data-reveal>
            <p class="text-xs tracking-[0.35em] text-accent">{t('hero.sub')}</p>
            <p class="font-display text-title tracking-[0.15em]" aria-hidden="true">
              {SITE.artistNameDisplay}
            </p>
            <p class="font-serif text-base tracking-[0.5em] text-muted">{SITE.artistNameJa}</p>
          </div>
        </div>
      )
    }

    <!--
      演奏写真の額装:
      - ずらした罫線（額の影のような藍のオフセットフレーム）
      - マスク演出 + ズームリビール（data-zoom）+ 緩やかなパララックス
    -->
    <figure class="relative mr-4 mb-4" data-reveal>
      <div
        class="absolute inset-0 translate-x-4 translate-y-4 border border-accent/40"
        aria-hidden="true"
      >
      </div>
      <div class="relative overflow-hidden" data-mask-reveal>
        <div data-parallax="0.05">
          <Image
            src={performancePhoto}
            alt={lang === 'ja' ? '菊池光峰 演奏写真' : 'KIKUCHI Mitsutaka performing the shamisen'}
            widths={[420, 800]}
            sizes="(min-width: 768px) 24rem, 80vw"
            class="aspect-[2/3] h-[44svh] w-auto object-cover md:h-[64svh]"
            loading="eager"
            fetchpriority="high"
            data-zoom
          />
        </div>
      </div>
    </figure>
  </div>

  <a
    href="#content"
    class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-muted hover:text-accent transition-colors"
  >
    <span class="text-[10px] tracking-[0.3em] uppercase">{t('hero.scroll')}</span>
    <span class="scroll-hint-line block h-10 w-px bg-current"></span>
  </a>
</section>
