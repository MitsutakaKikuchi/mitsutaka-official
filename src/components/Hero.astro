---
import { Image } from 'astro:assets';
import performancePhoto from '../assets/photos/performance.jpg';
import Strings from './Strings.astro';
import InkEnsou from './InkEnsou.astro';
import { SITE } from '../config/site';
import { localePath } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// キネティック・タイポグラフィ用に1文字ずつ分割（GSAP がステージング表示する）
const catchChars = [...t('hero.catchcopy')];

const photoAlt =
  lang === 'ja'
    ? '舞台で長唄三味線を演奏する菊池光峰'
    : 'KIKUCHI Mitsutaka performing nagauta shamisen on stage';
---

<!--
  ヒーロー = 夜の舞台。
  暗転した舞台に、三味線の三本の弦が光の線として走る（触れると鳴る）。
  固定ヘッダーの下に潜り込むため pt-16 で内容を下げ、高さは 100svh。
-->
<section
  id="hero"
  class="theme-night night-sky relative flex min-h-[100svh] items-center justify-center overflow-hidden pt-16"
  data-theme="night"
  data-strings-host
>
  <!-- WebGL パーティクル（舞台の塵が照明に浮かぶように。reduced-motion 時は起動しない） -->
  <canvas
    id="hero-canvas"
    class="pointer-events-none absolute inset-0 h-full w-full"
    aria-hidden="true"></canvas>

  <!--
    一円相（伝統）: 穂先の毛まで描いた筆の円相が一筆で書かれ、描き終えると墨の濃淡が静かに呼吸する。
    その上を WebGL の光の粒子（未来）が筆跡に沿ってなぞり、スクロールすると火の粉のように舞い上がる。
  -->
  <InkEnsou
    name="hero"
    cx={420}
    cy={400}
    r={300}
    seed={7}
    preserveAspectRatio="xMidYMid slice"
    class="ensou-breath absolute inset-x-0 top-0 h-[100svh] w-full text-paper opacity-[0.17]"
    frameClass="hero-ensou-frame"
  />

  <!-- 光の三本弦（一の糸・二の糸・三の糸）。ポインタで横切る／タップすると弾かれる -->
  <Strings angle={-22} baseY={610} gap={22} intro />

  <!-- タップ位置に朱の落款が捺される波紋 -->
  <div id="hero-ripples" class="pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div
    class="hero-fade relative mx-auto grid w-full max-w-6xl items-center justify-items-center gap-10 px-4 pt-8 pb-28 sm:px-6 sm:gap-12 sm:pt-10 sm:pb-32 md:grid-cols-[1fr_auto]"
  >
    {
      lang === 'ja' ? (
        /* スマホでは「名前・キャッチコピー → 写真 → 欧文名・ボタン」の順に並べるため、
           md 未満ではこの枠を解いて（display: contents）子要素を order で並べ替える */
        <div class="contents md:flex md:flex-col md:items-center md:gap-8">
          {/* 縦書き: 右のキャッチコピー → 左の名前 の順に読む */}
          <div class="order-1 flex flex-row-reverse items-start justify-center gap-7 sm:gap-12 md:order-none">
            <h1 class="vertical-text max-h-[min(34rem,calc(100svh-20rem))] font-serif text-lead leading-loose tracking-[0.42em] text-paper/80">
              {/* 読点の後で改行し「伝統を弾き、／いまを鳴らす。」の2行にする */}
              {catchChars.map((char) => (
                <>
                  <span class="k-char">{char}</span>
                  {char === '、' && <br />}
                </>
              ))}
              <span class="sr-only">{SITE.artistNameJa}</span>
            </h1>
            <div class="flex flex-row-reverse items-start gap-4 sm:gap-5" data-reveal>
              <p class="vertical-text text-xs tracking-[0.5em] text-glow sm:text-sm">
                {t('hero.sub')}
              </p>
              <p
                class="vertical-text font-display text-display tracking-[0.3em] text-paper [text-shadow:0_0_40px_rgb(143_179_224/0.25)]"
                aria-hidden="true"
              >
                {SITE.artistNameJa}
              </p>
            </div>
          </div>
          <div class="order-3 flex w-full flex-col items-center gap-7 sm:gap-8 md:order-none">
          <p class="hud text-paper/50" data-reveal aria-hidden="true" data-scramble>
            {SITE.artistNameDisplay}
          </p>
          <div
            class="hero-cta flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-center sm:gap-8"
            data-reveal
          >
            <a
              href={`${localePath(lang, 'contact/')}#booking`}
              class="btn-cta btn-light w-full max-w-xs px-8 py-3.5 text-center text-sm tracking-[0.3em] sm:w-auto"
              data-magnetic
            >
              {t('hero.ctaPrimary')}
            </a>
            <a
              href={localePath(lang, 'schedule/')}
              class="link-night link-arrow pb-1 text-sm tracking-[0.2em]"
            >
              {t('hero.ctaSecondary')} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          </div>
        </div>
      ) : (
        <div class="contents md:flex md:w-full md:flex-col md:gap-6">
          <div class="order-1 flex w-full flex-col gap-6 md:order-none">
          {/* 単語ごとに inline-block + whitespace-nowrap で包み、単語間は実スペースで分かち書き */}
          <h1 class="font-serif text-headline tracking-[0.1em] text-paper">
            {t('hero.catchcopy')
              .split(' ')
              .map((word, wordIndex) => (
                <>
                  {wordIndex > 0 && ' '}
                  <span class="inline-block whitespace-nowrap">
                    {[...word].map((char) => (
                      <span class="k-char">{char}</span>
                    ))}
                  </span>
                </>
              ))}
            <span class="sr-only">{SITE.artistNameEn}</span>
          </h1>
          <div class="flex flex-col gap-2" data-reveal>
            <p class="hud text-glow" data-scramble>{t('hero.sub')}</p>
            <p class="font-display text-title tracking-[0.15em]" aria-hidden="true">
              {SITE.artistNameDisplay}
            </p>
            <p class="font-serif text-base tracking-[0.5em] text-paper/55">{SITE.artistNameJa}</p>
          </div>
          </div>
          <div
            class="hero-cta order-3 mt-2 flex w-full flex-col gap-4 sm:flex-row sm:items-center sm:gap-8 md:order-none"
            data-reveal
          >
            <a
              href={`${localePath(lang, 'contact/')}#booking`}
              class="btn-cta btn-light w-full max-w-xs px-8 py-3.5 text-center text-sm tracking-[0.25em] sm:w-auto"
              data-magnetic
            >
              {t('hero.ctaPrimary')}
            </a>
            <a
              href={localePath(lang, 'schedule/')}
              class="link-night link-arrow self-start pb-1 text-sm tracking-[0.2em] sm:self-auto"
            >
              {t('hero.ctaSecondary')} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      )
    }

    <!--
      演奏写真: 四隅のブラケット（ファインダー）で額装する近未来の「額」。
      マスク + ズームリビール + パララックス、スマホでは傾きで僅かに揺れる。
    -->
    <figure class="relative order-2 m-3 md:order-none" data-reveal data-tilt>
      <span class="hud-corners text-glow/70" aria-hidden="true"></span>
      <div class="relative overflow-hidden" data-mask-reveal data-scan>
        <div data-parallax="0.05">
          <Image
            src={performancePhoto}
            alt={photoAlt}
            widths={[420, 800]}
            sizes="(min-width: 768px) 24rem, 80vw"
            class="aspect-[2/3] h-[40svh] w-auto object-cover sm:h-[44svh] md:h-[62svh]"
            loading="eager"
            fetchpriority="high"
            data-zoom
          />
        </div>
        <!-- 舞台照明の余韻: 写真の下端を夜に溶かす -->
        <span
          class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-night/70 to-transparent"
          aria-hidden="true"></span>
      </div>
      <figcaption class="hud mt-3 flex justify-end text-paper/45">
        <span>{lang === 'ja' ? '長唄三味線' : 'Nagauta shamisen'}</span>
      </figcaption>
    </figure>
  </div>

  <!-- 下部: スクロール誘導／活動拠点 -->
  <div
    class="absolute inset-x-0 bottom-0 mx-auto flex max-w-6xl items-end justify-end gap-4 px-4 pb-5 sm:px-6 sm:pb-6"
  >
    <a
      href="#about"
      class="absolute bottom-5 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-paper/50 transition-colors hover:text-paper sm:bottom-6 sm:flex"
    >
      <span class="hud">{t('hero.scroll')}</span>
      <span class="scroll-hint-line block h-8 w-px bg-current sm:h-10"></span>
    </a>
    <p class="hud hidden text-right text-paper/40 md:block">
      Based in Tokyo
    </p>
  </div>

  <span class="night-seam" aria-hidden="true"></span>
</section>
