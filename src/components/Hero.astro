---
import { Image } from 'astro:assets';
import performancePhoto from '../assets/photos/performance.jpg';
import { SITE } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// キネティック・タイポグラフィ用に1文字ずつ分割（GSAP がステージング表示する）
const catchChars = [...t('hero.catchcopy')];
---

<section
  class="relative flex min-h-[calc(100svh-4rem)] items-center justify-center overflow-hidden"
>
  <!-- WebGL パーティクル（藍の粒子・マウス反応。reduced-motion 時は起動しない） -->
  <canvas id="hero-canvas" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"
  ></canvas>

  <!-- 円相をモチーフにした SVG ラインドローイング -->
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1200 800"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <circle
      data-draw
      cx="420"
      cy="400"
      r="300"
      fill="none"
      stroke="#1b3a5b"
      stroke-opacity="0.14"
      stroke-width="1.5"></circle>
    <line
      data-draw
      x1="150"
      y1="700"
      x2="1050"
      y2="60"
      stroke="#1a1a1a"
      stroke-opacity="0.07"
      stroke-width="1"></line>
  </svg>

  <div
    class="relative mx-auto grid w-full max-w-6xl items-center justify-items-center gap-12 px-4 py-12 sm:px-6 md:grid-cols-[1fr_auto]"
  >
    {
      lang === 'ja' ? (
        <div class="flex flex-col items-center gap-8">
          {/* 縦書き: 右のキャッチコピー → 左の名前 の順に読む */}
          <div class="flex flex-row-reverse items-start justify-center gap-8 sm:gap-12">
            <h1 class="vertical-text max-h-[min(34rem,calc(100svh-14rem))] font-serif text-xl leading-loose tracking-[0.42em] text-ink/80 sm:text-2xl">
              {catchChars.map((char) => (
                <span class="k-char">{char}</span>
              ))}
              <span class="sr-only">{SITE.artistNameJa}</span>
            </h1>
            <div class="flex flex-row-reverse items-start gap-5" data-reveal>
              <p class="vertical-text text-xs tracking-[0.5em] text-accent sm:text-sm">
                {t('hero.sub')}
              </p>
              <p
                class="vertical-text font-serif text-5xl tracking-[0.3em] sm:text-6xl md:text-7xl"
                aria-hidden="true"
              >
                {SITE.artistNameJa}
              </p>
            </div>
          </div>
          <p class="text-[10px] tracking-[0.5em] text-muted" data-reveal>
            {SITE.artistNameDisplay}
          </p>
        </div>
      ) : (
        <div class="flex flex-col gap-6">
          <h1 class="font-serif text-3xl leading-snug tracking-[0.1em] sm:text-4xl md:text-5xl">
            {catchChars.map((char) => (
              <span class="k-char">{char === ' ' ? ' ' : char}</span>
            ))}
            <span class="sr-only">{SITE.artistNameEn}</span>
          </h1>
          <div class="flex flex-col gap-2" data-reveal>
            <p class="text-xs tracking-[0.35em] text-accent">{t('hero.sub')}</p>
            <p class="font-serif text-3xl tracking-[0.15em] sm:text-4xl" aria-hidden="true">
              {SITE.artistNameDisplay}
            </p>
            <p class="font-serif text-base tracking-[0.5em] text-muted">{SITE.artistNameJa}</p>
          </div>
        </div>
      )
    }

    <!-- 演奏写真: マスク演出で表示し、スクロールで緩やかにパララックス -->
    <figure class="relative" data-mask-reveal>
      <div data-parallax="0.08">
        <Image
          src={performancePhoto}
          alt={lang === 'ja' ? '菊池光峰 演奏写真' : 'KIKUCHI Mitsutaka performing the shamisen'}
          widths={[420, 800]}
          sizes="(min-width: 768px) 24rem, 80vw"
          class="aspect-[2/3] h-[48svh] w-auto object-cover md:h-[68svh]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </figure>
  </div>

  <a
    href="#content"
    class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-muted hover:text-accent transition-colors"
  >
    <span class="text-[10px] tracking-[0.3em] uppercase">{t('hero.scroll')}</span>
    <span class="block h-10 w-px bg-current"></span>
  </a>
</section>
