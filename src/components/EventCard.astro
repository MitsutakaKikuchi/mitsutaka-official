---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate } from '../i18n/utils';
import { resolveImageUrl } from '../lib/images';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  event: CollectionEntry<'schedule'>;
  lang: Lang;
  past?: boolean;
  /** 直近の公演（NEXT バッジとカウントダウンを表示） */
  next?: boolean;
}

const { event, lang, past = false, next = false } = Astro.props;
const t = useTranslations(lang);
const { data } = event;

const title = lang === 'ja' ? data.titleJa : data.titleEn;
const venue = lang === 'ja' ? data.venueJa : data.venueEn;
const city = lang === 'ja' ? data.cityJa : data.cityEn;
const regionNames = new Intl.DisplayNames([lang], { type: 'region' });
// 国コードが無効な場合は元の値を使用（スプレッドシート側での修正が必要）
let countryName = data.country?.trim() || 'JP';
// 国コードが2文字でない場合はJPをデフォルト
if (!countryName || countryName.length !== 2 || countryName.trim() === '') {
  countryName = 'JP';
}
try {
  const name = regionNames.of(countryName);
  countryName = name || countryName;
} catch (error) {
  // 無効な国コードの場合はそのまま使用
  console.warn(`Invalid country code: "${data.country}"`, error);
}

// チラシ→演奏写真の順で全画像を表示（どちらも無い公演はテキストのみ）。複数ある場合はスライドショー表示
const flyerImages = data.flyerUrls.map(resolveImageUrl);
const photoImages = data.photoUrls.map(resolveImageUrl);
const images = [...flyerImages, ...photoImages];
const imageLabel = flyerImages.length > 0 ? t('schedule.flyer') : t('schedule.photo');
const imageAlt = `${imageLabel}: ${title}`;

const SLIDESHOW_INTERVAL_MS = 4000;

// 共演者は個別チップではなく1行にまとめて表示する（多数いても整然と並ぶ）
const performerSeparator = lang === 'ja' ? '、' : ', ';
const performerList = data.performers.join(performerSeparator);

// アクション（チケット / 詳細ページ）が1つでもあるか
const hasTicketAction = !past && (data.soldOut || Boolean(data.ticketUrl));
const hasActions = hasTicketAction || Boolean(data.websiteUrl);

// 日付ブロック（年 / 月.日 / 曜日）。公演日はタイムゾーンに依らず日付として扱う
const isoDate = data.date.toISOString().slice(0, 10);
const [year, month, day] = isoDate.split('-');
const weekday = new Intl.DateTimeFormat(lang === 'ja' ? 'ja-JP' : 'en-US', {
  weekday: 'short',
  timeZone: 'UTC',
}).format(data.date);
---

<article
  class:list={[
    'group/card relative border-b border-line px-3 py-7 transition-colors hover:bg-accent/[0.04]',
    past && 'opacity-60 hover:opacity-90',
  ]}
  data-reveal
>
  {/* ホバー時に左端へ朱の罫線が縦に引かれる（落款の朱を想起）。装飾のみ */}
  <span
    aria-hidden="true"
    class="pointer-events-none absolute left-0 top-0 h-full w-[2px] origin-top scale-y-0 bg-vermilion transition-transform duration-500 ease-out group-hover/card:scale-y-100"
  ></span>
  <div class="grid gap-4 sm:grid-cols-[6.5rem_1fr_auto] sm:gap-8">
    {/* 日付ブロック: 一目で日付が拾えるよう大きく。モバイルは横一列 */}
    <time
      datetime={isoDate}
      class="flex items-baseline gap-3 sm:flex-col sm:items-start sm:gap-1"
      aria-label={formatEventDate(data.date, lang)}
    >
      <span class="hud text-muted" aria-hidden="true">{year}</span>
      <span class="event-date-day text-[2rem] leading-none tracking-[0.04em] text-ink sm:text-[2.5rem]" aria-hidden="true">
        {month}.{day}
      </span>
      <span class="hud text-accent" aria-hidden="true">{weekday}</span>
    </time>

    <div class="min-w-0">
      {
        (next || (data.soldOut && !past)) && (
          <p class="mb-2 flex flex-wrap items-center gap-2">
            {next && (
              <span class="hud inline-flex items-center gap-1.5 bg-ink px-2 py-0.5 text-paper">
                <span class="h-1.5 w-1.5 rounded-full bg-vermilion" aria-hidden="true" />
                Next
              </span>
            )}
            {next && (
              <span
                class="hud text-vermilion"
                data-countdown={isoDate}
                data-label-today={lang === 'ja' ? '本日開催' : 'Today'}
                data-label-days={lang === 'ja' ? 'あと{n}日' : 'In {n} days'}
                data-label-tomorrow={lang === 'ja' ? '明日開催' : 'Tomorrow'}
              />
            )}
            {data.soldOut && !past && (
              <span class="hud border border-line px-2 py-0.5 text-muted">{t('schedule.soldOut')}</span>
            )}
          </p>
        )
      }

      {/* 日本語の長いタイトルの折り返し制御（keep-all + 中黒の後に wbr + anywhere） */}
      <h3
        class="font-serif text-lg leading-snug tracking-wider text-balance [word-break:keep-all] [overflow-wrap:anywhere] sm:text-xl"
      >
        {title.split('・').map((segment, index) => (
          <>
            {index > 0 && '・'}
            {index > 0 && <wbr />}
            {segment}
          </>
        ))}
      </h3>

      <p class="mt-2 flex items-start gap-2 text-sm text-muted">
        <svg viewBox="0 0 16 16" class="mt-[0.2rem] h-3.5 w-3.5 shrink-0 text-accent/70" aria-hidden="true">
          <path d="M8 15s5-4.6 5-8.5A5 5 0 0 0 3 6.5C3 10.4 8 15 8 15z" fill="none" stroke="currentColor" stroke-width="1.2"></path>
          <circle cx="8" cy="6.5" r="1.6" fill="currentColor"></circle>
        </svg>
        <span>{venue} — {city}{data.country !== 'JP' || lang === 'en' ? `, ${countryName}` : ''}</span>
      </p>

      {
        data.genres.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {data.genres.map((genre) => (
              <span class="border border-accent/30 px-2.5 py-1 text-[0.7rem] leading-none tracking-wider text-accent">
                {genre}
              </span>
            ))}
          </div>
        )
      }

      {
        performerList && (
          <p class="mt-3 text-xs leading-relaxed text-muted">
            <span class="tracking-wider text-accent/80">{t('schedule.with')}</span> {performerList}
          </p>
        )
      }

      {
        data.notes && (
          <p class="mt-1.5 text-xs leading-relaxed text-muted">
            <span class="tracking-wider text-accent/80">{t('schedule.notes')}</span> {data.notes}
          </p>
        )
      }

      {
        hasActions && (
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
            {hasTicketAction && !data.soldOut && data.ticketUrl && (
              <a
                href={data.ticketUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-10 items-center gap-2 bg-accent px-5 py-2 text-xs tracking-widest text-white transition-colors hover:bg-accent-dark"
              >
                {t('schedule.tickets')}
                <span aria-hidden="true">↗</span>
                <span class="sr-only">{lang === 'ja' ? '（新しいタブで開く）' : '(opens in a new tab)'}</span>
              </a>
            )}
            {data.websiteUrl && (
              <a
                href={data.websiteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="link-arrow inline-flex min-h-10 items-center gap-1.5 text-xs tracking-widest text-accent/80 transition-colors hover:text-accent"
              >
                {t('schedule.website')}
                <span aria-hidden="true" class="arrow">↗</span>
                <span class="sr-only">{lang === 'ja' ? '（新しいタブで開く）' : '(opens in a new tab)'}</span>
              </a>
            )}
          </div>
        )
      }
    </div>

    {
      images.length > 0 && (
        <button
          type="button"
          data-lightbox
          data-event-images
          data-images={JSON.stringify(images)}
          aria-label={imageAlt}
          class="group relative shrink-0 self-start"
        >
          <span
            class="relative block h-56 w-full overflow-hidden border border-line bg-line/15 transition-transform duration-500 ease-out group-hover:scale-[1.03] sm:h-40 sm:w-28"
            data-slideshow={images.length > 1 ? SLIDESHOW_INTERVAL_MS : undefined}
          >
            {images.map((src, index) => {
              const isFlyer = index < flyerImages.length;
              return (
                <img
                  src={src}
                  alt={index === 0 ? imageAlt : ''}
                  aria-hidden={index === 0 ? undefined : 'true'}
                  loading="lazy"
                  data-slide
                  class:list={[
                    'absolute inset-0 h-full w-full transition-opacity duration-1000',
                    isFlyer ? 'object-contain' : 'object-cover',
                    index === 0 ? 'opacity-100' : 'opacity-0',
                  ]}
                />
              );
            })}
          </span>
          {/* 拡大できることを示すアイコン */}
          <span
            class="absolute right-1.5 bottom-1.5 flex h-7 w-7 items-center justify-center bg-ink/70 text-paper opacity-90 transition-opacity group-hover:opacity-100"
            aria-hidden="true"
          >
            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5">
              <path d="M9.5 2.5h4v4M6.5 13.5h-4v-4M13.5 2.5 9 7M2.5 13.5 7 9" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
            </svg>
          </span>
          {images.length > 1 && (
            <span class="hud absolute left-1.5 bottom-1.5 bg-ink/70 px-1.5 text-paper" aria-hidden="true">
              {images.length}
            </span>
          )}
        </button>
      )
    }
  </div>
</article>
