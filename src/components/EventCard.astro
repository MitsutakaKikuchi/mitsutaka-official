---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate, withBase } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  event: CollectionEntry<'schedule'>;
  lang: Lang;
  past?: boolean;
}

const { event, lang, past = false } = Astro.props;
const t = useTranslations(lang);
const { data } = event;

const title = lang === 'ja' ? data.titleJa : data.titleEn;
const venue = lang === 'ja' ? data.venueJa : data.venueEn;
const city = lang === 'ja' ? data.cityJa : data.cityEn;
const regionNames = new Intl.DisplayNames([lang], { type: 'region' });
// 国コードが無効な場合は元の値を使用（スプレッドシート側での修正が必要）
let countryName = data.country?.trim() || 'JP';
// 国コードが2文字でない場合はJPをデフォルト
if (!countryName || countryName.length !== 2 || countryName.trim() === '') {
  countryName = 'JP';
}
try {
  const name = regionNames.of(countryName);
  countryName = name || countryName;
} catch (error) {
  // 無効な国コードの場合はそのまま使用
  console.warn(`Invalid country code: "${data.country}"`, error);
}

// Google ドライブの共有リンク（/open?id=, /file/d/<id>/view, /uc?...id=）から
// ファイルIDを取り出すパターン。これらのURLはビューア用ページを返すため
// <img> では表示できない
const GOOGLE_DRIVE_URL_PATTERN = /drive\.google\.com\/(?:open\?id=|file\/d\/|uc\?[^#]*id=)([\w-]+)/;

/**
 * 完全URLはそのまま、サイト内パスは base を付与する。
 * Google ドライブの共有リンクは、画像として直接表示できる形式に変換する
 */
function resolveImageUrl(url: string): string {
  const driveMatch = url.match(GOOGLE_DRIVE_URL_PATTERN);
  if (driveMatch) {
    return `https://lh3.googleusercontent.com/d/${driveMatch[1]}=w1600`;
  }
  return /^https?:\/\//.test(url) ? url : withBase(url);
}

// チラシ→演奏写真の順で全画像を表示（どちらも無い公演はテキストのみ）。複数ある場合はスライドショー表示
const flyerImages = data.flyerUrls.map(resolveImageUrl);
const photoImages = data.photoUrls.map(resolveImageUrl);
const images = [...flyerImages, ...photoImages];
const imageLabel = flyerImages.length > 0 ? t('schedule.flyer') : t('schedule.photo');
const imageAlt = `${imageLabel}: ${title}`;

const SLIDESHOW_INTERVAL_MS = 4000;

// 共演者は個別チップではなく1行にまとめて表示する（多数いても整然と並ぶ）
const performerSeparator = lang === 'ja' ? '、' : ', ';
const performerList = data.performers.join(performerSeparator);

// アクション（チケット / 詳細ページ）が1つでもあるか
const hasTicketAction = !past && (data.soldOut || Boolean(data.ticketUrl));
const hasActions = hasTicketAction || Boolean(data.websiteUrl);
---

<article
  class:list={[
    'border-b border-line px-3 py-6 -mx-3 transition-colors hover:bg-accent/[0.04]',
    past && 'opacity-60',
  ]}
  data-reveal
>
  <div class="flex flex-col gap-3 sm:flex-row sm:gap-6">
    {
      images.length > 0 && (
        <button
          type="button"
          data-lightbox
          data-images={JSON.stringify(images)}
          aria-label={imageAlt}
          class="group shrink-0"
        >
          <span
            class="relative block h-40 w-full overflow-hidden border border-line bg-line/15 transition-transform duration-500 ease-out group-hover:scale-[1.03] sm:h-32 sm:w-24"
            data-slideshow={images.length > 1 ? SLIDESHOW_INTERVAL_MS : undefined}
          >
            {images.map((src, index) => {
              const isFlyer = index < flyerImages.length;
              return (
                <img
                  src={src}
                  alt={index === 0 ? imageAlt : ''}
                  aria-hidden={index === 0 ? undefined : 'true'}
                  loading="lazy"
                  data-slide
                  class:list={[
                    'absolute inset-0 h-full w-full transition-opacity duration-1000 hover:opacity-80',
                    isFlyer ? 'object-contain' : 'object-cover',
                    index === 0 ? 'opacity-100' : 'opacity-0',
                  ]}
                />
              );
            })}
          </span>
        </button>
      )
    }

    <div class="min-w-0 flex-1">
      {/* 日付は見出し上のアイブロウとして配置 */}
      <time
        datetime={data.date.toISOString().slice(0, 10)}
        class="block text-xs tracking-[0.2em] text-accent"
      >
        {formatEventDate(data.date, lang)}
      </time>

      <h3 class="mt-1.5 font-serif text-lg leading-snug tracking-wider">{title}</h3>

      <p class="mt-1 text-sm text-muted">
        {venue} — {city}{data.country !== 'JP' || lang === 'en' ? `, ${countryName}` : ''}
      </p>

      {
        data.genres.length > 0 && (
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {data.genres.map((genre) => (
              <span class="border border-accent/30 px-2 py-0.5 text-[0.65rem] tracking-wider text-accent">
                {genre}
              </span>
            ))}
          </div>
        )
      }

      {/* 共演者は1行にまとめて静かに表示する */}
      {
        performerList && (
          <p class="mt-2 text-xs leading-relaxed text-muted">
            <span class="tracking-wider text-accent/70">{t('schedule.with')}</span> {performerList}
          </p>
        )
      }

      {
        hasActions && (
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {hasTicketAction &&
              (data.soldOut ? (
                <span class="border border-line px-4 py-2 text-xs tracking-widest text-muted">
                  {t('schedule.soldOut')}
                </span>
              ) : (
                data.ticketUrl && (
                  <a
                    href={data.ticketUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border border-accent px-4 py-2 text-xs tracking-widest text-accent transition-colors hover:bg-accent hover:text-white"
                  >
                    {t('schedule.tickets')}
                  </a>
                )
              ))}
            {data.websiteUrl && (
              <a
                href={data.websiteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-accent/60 px-4 py-2 text-xs tracking-widest text-accent/80 transition-colors hover:border-accent hover:text-accent"
              >
                {t('schedule.website')}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>
