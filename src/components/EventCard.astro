---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate, withBase } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  event: CollectionEntry<'schedule'>;
  lang: Lang;
  past?: boolean;
}

const { event, lang, past = false } = Astro.props;
const t = useTranslations(lang);
const { data } = event;

const title = lang === 'ja' ? data.titleJa : data.titleEn;
const venue = lang === 'ja' ? data.venueJa : data.venueEn;
const city = lang === 'ja' ? data.cityJa : data.cityEn;
const regionNames = new Intl.DisplayNames([lang], { type: 'region' });
// 国コードが無効な場合は那存在するもとの値を使用（スプレッドシート側での修正が必要）
let countryName = data.country || 'JP';
try {
  const name = regionNames.of(countryName);
  countryName = name || countryName;
} catch {
  // 無効な国コードの場合はそのまま使用
}

/** 完全URLはそのまま、サイト内パスは base を付与する */
function resolveImageUrl(url: string): string {
  return /^https?:\/\//.test(url) ? url : withBase(url);
}

// チラシ優先、なければ演奏写真（どちらも無い公演はテキストのみ）。複数ある場合はスライドショー表示
const flyerImages = data.flyerUrls.map(resolveImageUrl);
const photoImages = data.photoUrls.map(resolveImageUrl);
const images = flyerImages.length > 0 ? flyerImages : photoImages;
const imageLabel = flyerImages.length > 0 ? t('schedule.flyer') : t('schedule.photo');
const imageAlt = `${imageLabel}: ${title}`;

const SLIDESHOW_INTERVAL_MS = 4000;
---

<article
  class:list={[
    'grid gap-3 border-b border-line px-3 py-6 -mx-3 transition-colors hover:bg-accent/[0.04] sm:grid-cols-[10rem_1fr_auto] sm:items-center',
    past && 'opacity-60',
  ]}
  data-reveal
>
  <time datetime={data.date.toISOString().slice(0, 10)} class="text-sm tracking-wider text-accent">
    {formatEventDate(data.date, lang)}
  </time>
  <div class="flex items-start gap-4">
    {
      images.length > 0 && (
        <button
          type="button"
          data-lightbox
          data-images={JSON.stringify(images)}
          aria-label={imageAlt}
          class="shrink-0"
        >
          <span
            class="relative block h-24 w-[4.5rem] overflow-hidden border border-line"
            data-slideshow={images.length > 1 ? SLIDESHOW_INTERVAL_MS : undefined}
          >
            {images.map((src, index) => (
              <img
                src={src}
                alt={index === 0 ? imageAlt : ''}
                aria-hidden={index === 0 ? undefined : 'true'}
                loading="lazy"
                data-slide
                class:list={[
                  'absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 hover:opacity-80',
                  index === 0 ? 'opacity-100' : 'opacity-0',
                ]}
              />
            ))}
          </span>
        </button>
      )
    }
    <div>
      <h3 class="font-serif text-lg tracking-wider">{title}</h3>
      <p class="mt-1 text-sm text-muted">
        {venue} — {city}{data.country !== 'JP' || lang === 'en' ? `, ${countryName}` : ''}
      </p>
    </div>
  </div>
  {
    (data.websiteUrl || (!past && (data.soldOut || data.ticketUrl))) && (
      <div class="flex flex-col items-start gap-2 justify-self-start sm:items-end sm:justify-self-end">
        {!past &&
          (data.soldOut ? (
            <span class="text-xs tracking-widest text-muted border border-line px-4 py-2">
              {t('schedule.soldOut')}
            </span>
          ) : (
            data.ticketUrl && (
              <a
                href={data.ticketUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-accent text-accent hover:bg-accent hover:text-white transition-colors text-xs tracking-widest px-4 py-2"
              >
                {t('schedule.tickets')}
              </a>
            )
          ))}
        {data.websiteUrl && (
          <a
            href={data.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-line text-muted hover:border-accent hover:text-accent transition-colors text-xs tracking-widest px-4 py-2"
          >
            {t('schedule.website')}
          </a>
        )}
      </div>
    )
  }
</article>
