---
import InkEnsou from './InkEnsou.astro';
import { SITE } from '../config/site';
import { localePath } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const snsLinks = [{ label: 'Instagram', url: SITE.sns.instagram }].filter((link) => link.url);

const navItems = [
  { href: localePath(lang, 'about/'), label: t('nav.about') },
  { href: localePath(lang, 'schedule/'), label: t('nav.schedule') },
  { href: localePath(lang, 'media/'), label: t('nav.media') },
  { href: localePath(lang, 'contact/'), label: t('nav.contact') },
];

const legalItems = [
  { href: localePath(lang, 'privacy/'), label: t('legal.privacy') },
  { href: localePath(lang, 'terms/'), label: t('legal.terms') },
];
---

<footer class="theme-night relative overflow-hidden border-t border-paper/10 text-paper/90" data-theme="night">
  <!-- 背景の一円相: スクロールに合わせて筆が進む（ヒーローの円相と同じ筆致・別の一筆）。装飾のみ -->
  <InkEnsou
    name="footer"
    viewWidth={400}
    viewHeight={400}
    cx={200}
    cy={200}
    r={150}
    seed={23}
    bristles={12}
    steps={72}
    mode="scroll"
    class="absolute -right-16 -top-24 h-[22rem] w-[22rem] text-paper opacity-[0.13] sm:-right-10 sm:h-[30rem] sm:w-[30rem]"
  />

  <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-28 sm:px-6 sm:pb-14 md:pb-14">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
      <div class="flex flex-col gap-4">
        <p class="flex items-center gap-3 font-display text-2xl tracking-[0.3em]">
          <span class="h-2 w-2 rotate-45 bg-vermilion" aria-hidden="true"></span>
          {lang === 'ja' ? SITE.artistNameJa : SITE.artistNameDisplay}
        </p>
        <p class="hud text-paper/55">
          {lang === 'ja' ? SITE.artistNameDisplay : SITE.artistNameJa} — {
            lang === 'ja' ? '長唄三味線' : 'Nagauta Shamisen Player'
          }
        </p>
        <nav class="mt-2 flex gap-6" aria-label="Social media">
          {
            snsLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm tracking-widest text-paper/70 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex flex-col items-start gap-8 md:items-end">
        <nav class="grid grid-cols-2 gap-x-10 gap-y-1 md:justify-items-end" aria-label="Footer">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="flex min-h-10 items-center text-sm tracking-[0.2em] text-paper/80 transition-colors hover:text-white"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <!-- トップへ戻る: 縦の弦が伸びるボタン -->
        <a
          href="#content"
          data-to-top
          class="to-top hud flex min-h-10 items-center gap-3 text-paper/55 transition-colors hover:text-paper md:flex-col md:gap-2"
        >
          <span class="to-top-line block h-6 w-px bg-current md:h-8" aria-hidden="true"></span>
          <span>{t('footer.toTop')}</span>
        </a>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-paper/10 pt-6 text-xs tracking-wider text-paper/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.artistNameEn}. {t('footer.copyright')}</p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
        {
          legalItems.map((item) => (
            <a href={item.href} class="hover:text-paper transition-colors">
              {item.label}
            </a>
          ))
        }
        {
          SITE.ga4MeasurementId && (
            <a href="#" data-consent-open class="hover:text-paper transition-colors">
              {t('legal.cookieSettings')}
            </a>
          )
        }
      </nav>
    </div>
  </div>
</footer>
