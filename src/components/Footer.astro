---
import { SITE } from '../config/site';
import { localePath } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const snsLinks = [{ label: 'Instagram', url: SITE.sns.instagram }].filter((link) => link.url);

const navItems = [
  { href: localePath(lang, 'about/'), label: t('nav.about') },
  { href: localePath(lang, 'schedule/'), label: t('nav.schedule') },
  { href: localePath(lang, 'media/'), label: t('nav.media') },
  { href: localePath(lang, 'contact/'), label: t('nav.contact') },
];

const legalItems = [
  { href: localePath(lang, 'privacy/'), label: t('legal.privacy') },
  { href: localePath(lang, 'terms/'), label: t('legal.terms') },
];
---

<footer class="relative overflow-hidden border-t border-line bg-ink text-paper/90">
  <!-- 背景の一円相: スクロールで筆が走る（data-draw-scroll）。装飾のみ -->
  <svg
    class="pointer-events-none absolute -right-16 -top-24 h-[22rem] w-[22rem] opacity-[0.12] sm:-right-10 sm:h-[30rem] sm:w-[30rem]"
    viewBox="0 0 400 400"
    aria-hidden="true"
  >
    <path
      data-draw-scroll
      d="M296 96A150 150 0 1 0 336 214"
      fill="none"
      stroke="#f7f5f0"
      stroke-width="3"
      stroke-linecap="round"></path>
  </svg>

  <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-28 sm:px-6 sm:pb-14 md:pb-14">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
      <div class="flex flex-col gap-4">
        <p class="font-display text-2xl tracking-[0.3em]">
          {lang === 'ja' ? SITE.artistNameJa : SITE.artistNameDisplay}
        </p>
        <p class="text-xs tracking-[0.3em] text-paper/60">
          {lang === 'ja' ? SITE.artistNameDisplay : SITE.artistNameJa} — {
            lang === 'ja' ? '長唄三味線方' : 'Nagauta Shamisen Player'
          }
        </p>
        <nav class="mt-2 flex gap-6" aria-label="Social media">
          {
            snsLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm tracking-widest text-paper/70 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <nav class="grid grid-cols-2 gap-x-10 gap-y-3 md:justify-items-end" aria-label="Footer">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="text-sm tracking-[0.2em] text-paper/80 hover:text-white transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-paper/10 pt-6 text-xs tracking-wider text-paper/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.artistNameEn}. {t('footer.copyright')}</p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
        {
          legalItems.map((item) => (
            <a href={item.href} class="hover:text-paper transition-colors">
              {item.label}
            </a>
          ))
        }
        {
          SITE.ga4MeasurementId && (
            <a href="#" data-consent-open class="hover:text-paper transition-colors">
              {t('legal.cookieSettings')}
            </a>
          )
        }
      </nav>
    </div>
  </div>
</footer>
