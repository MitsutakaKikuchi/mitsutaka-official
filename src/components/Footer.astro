---
import { SITE } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const snsLinks = [{ label: 'Instagram', url: SITE.sns.instagram }].filter((link) => link.url);
---

<footer class="border-t border-line bg-ink text-paper/90">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-12 sm:px-6">
    <p class="font-display text-xl tracking-[0.3em]">
      {lang === 'ja' ? SITE.artistNameJa : SITE.artistNameDisplay}
    </p>
    <nav class="flex gap-6" aria-label="Social media">
      {
        snsLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm tracking-widest text-paper/70 hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <p class="text-xs tracking-wider text-paper/50">
      &copy; {year} {SITE.artistNameEn}. {t('footer.copyright')}
    </p>
  </div>
</footer>
