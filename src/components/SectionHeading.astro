---
interface Props {
  /** 欧文の見出し（例: Schedule） */
  en: string;
  /** 表示言語での見出し（例: 公演情報） */
  label: string;
  id?: string;
  /** 任意の索引番号（例: 1 → "01"）。縦のリズムを与える */
  index?: number;
  /** 見出しの右側に置く補助リンク（「すべて見る」など） */
  moreHref?: string;
  moreLabel?: string;
}

const { en, label, id, index, moreHref, moreLabel } = Astro.props;
const indexLabel = index !== undefined ? String(index).padStart(2, '0') : null;
---

<div class="mb-12 flex flex-wrap items-end justify-between gap-x-8 gap-y-4" data-reveal id={id}>
  <div>
    <p class="hud flex items-center gap-3 text-accent">
      {indexLabel && <span class="text-vermilion">{indexLabel}</span>}
      {en !== label && <span>{en}</span>}
      <span class="heading-rule h-px w-12 bg-accent/40" aria-hidden="true"></span>
    </p>
    <h2 class="mt-3 font-display text-title tracking-[0.12em]">{label}</h2>
  </div>
  {
    moreHref && moreLabel && (
      <a
        href={moreHref}
        class="link-arrow hidden border-b border-accent pb-1 text-sm tracking-[0.2em] text-accent transition-opacity hover:opacity-70 sm:inline-block"
      >
        {moreLabel} <span class="arrow" aria-hidden="true">→</span>
      </a>
    )
  }
</div>
