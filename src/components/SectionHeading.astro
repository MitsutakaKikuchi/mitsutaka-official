---
interface Props {
  /** 欧文の見出し（例: Schedule） */
  en: string;
  /** 表示言語での見出し（例: 公演情報） */
  label: string;
  id?: string;
}

const { en, label, id } = Astro.props;
---

<div class="mb-10 flex items-baseline gap-4" data-reveal id={id}>
  <h2 class="font-serif text-3xl tracking-[0.15em] sm:text-4xl">{label}</h2>
  {en !== label && <p class="text-xs tracking-[0.3em] uppercase text-accent">{en}</p>}
</div>
