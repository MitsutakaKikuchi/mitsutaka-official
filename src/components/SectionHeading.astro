---
interface Props {
  /** 欧文の見出し（例: Schedule） */
  en: string;
  /** 表示言語での見出し（例: 公演情報） */
  label: string;
  id?: string;
}

const { en, label, id } = Astro.props;
---

<div class="mb-12" data-reveal id={id}>
  <p class="flex items-center gap-3 text-[11px] tracking-[0.35em] uppercase text-accent">
    {en !== label && <span>{en}</span>}
    <span class="h-px w-12 bg-accent/40" aria-hidden="true"></span>
  </p>
  <h2 class="mt-3 font-display text-title tracking-[0.12em]">{label}</h2>
</div>
