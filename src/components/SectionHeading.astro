---
/**
 * 本文（昼の和紙）の節見出し。
 * - 欧文ラベル: 文化譜の数字が走ってから文字に定まる「デコード」演出（未来）
 * - 見出し本体: 筆で左から書かれていくように、墨の滲みを解きながら現れる（伝統）
 * 演出は scripts/motion.ts（data-scramble / data-brush）。reduced-motion では静的表示。
 */
interface Props {
  /** 欧文の見出し（例: Schedule） */
  en: string;
  /** 表示言語での見出し（例: 公演情報） */
  label: string;
  id?: string;
  /** 見出しの右側に置く補助リンク（「すべて見る」など） */
  moreHref?: string;
  moreLabel?: string;
}

const { en, label, id, moreHref, moreLabel } = Astro.props;
---

<div class="mb-12 flex flex-wrap items-end justify-between gap-x-8 gap-y-4" data-reveal id={id}>
  <div>
    <p class="hud flex items-center gap-3 text-accent">
      {en !== label && <span aria-hidden="true" data-scramble>{en}</span>}
      <span class="heading-rule h-px w-12 bg-accent/40" aria-hidden="true"></span>
    </p>
    <h2 class="mt-3 font-display text-title tracking-[0.12em]" data-brush>{label}</h2>
  </div>
  {
    moreHref && moreLabel && (
      <a
        href={moreHref}
        class="link-arrow hidden border-b border-accent pb-1 text-sm tracking-[0.2em] text-accent transition-opacity hover:opacity-70 sm:inline-block"
      >
        {moreLabel} <span class="arrow" aria-hidden="true">→</span>
      </a>
    )
  }
</div>
