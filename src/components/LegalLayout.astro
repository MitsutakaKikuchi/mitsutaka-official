---
/**
 * プライバシーポリシー・利用規約など、長文の規約ページ共通レイアウト。
 * 見出し + 本文の配列を受け取り、読みやすい行間・文字幅で組む。
 */
import PageHero from './PageHero.astro';
import { SITE } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

export interface LegalSection {
  heading: string;
  /** 段落。配列の要素が配列の場合は箇条書きとして描画する */
  body: (string | string[])[];
}

interface Props {
  lang: Lang;
  en: string;
  title: string;
  intro: string;
  sections: LegalSection[];
}

const { lang, en, title, intro, sections } = Astro.props;
const t = useTranslations(lang);
const updated = new Date(SITE.legalUpdatedAt);
const updatedLabel = new Intl.DateTimeFormat(lang === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(updated);
---

<PageHero lang={lang} en={en} label={title} />
<div class="mx-auto max-w-3xl px-4 py-section sm:px-6">
  {/* 目次: 長文でも目的の条文へすぐ移動できるように */}
  <nav class="mb-12 border border-line bg-white/50 p-5 sm:p-6" aria-label={lang === 'ja' ? '目次' : 'Contents'} data-reveal>
    <p class="hud mb-3 text-accent">{lang === 'ja' ? '目次' : 'Contents'}</p>
    <ol class="grid gap-x-8 gap-y-1.5 text-sm sm:grid-cols-2">
      {sections.map((section, index) => (
        <li>
          <a href={`#sec-${index + 1}`} class="flex gap-3 py-1 text-ink/75 transition-colors hover:text-accent">
            <span class="hud pt-0.5 text-vermilion">{String(index + 1).padStart(2, '0')}</span>
            <span>{section.heading}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <p class="leading-loose text-ink/85" data-reveal>{intro}</p>

  <div class="mt-12 space-y-12">
    {
      sections.map((section, index) => (
        <section id={`sec-${index + 1}`} class="scroll-mt-24" data-reveal>
          <h2 class="flex items-baseline gap-4 font-serif text-xl tracking-[0.12em]">
            <span class="hud text-vermilion">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="min-w-0 break-words [word-break:auto-phrase]">{section.heading}</span>
          </h2>
          <div class="mt-4 space-y-4 text-[0.95rem] leading-loose text-ink/85 [overflow-wrap:anywhere]">
            {section.body.map((block) =>
              Array.isArray(block) ? (
                <ul class="list-disc space-y-1 pl-6 marker:text-accent/60">
                  {block.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : (
                <p>{block}</p>
              )
            )}
          </div>
        </section>
      ))
    }
  </div>

  <p class="mt-16 border-t border-line pt-6 text-xs tracking-[0.2em] text-muted" data-reveal>
    {t('legal.updated')}: <time datetime={SITE.legalUpdatedAt}>{updatedLabel}</time>
  </p>
</div>
