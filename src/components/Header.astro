---
import { SITE } from '../config/site';
import { localePath } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  subpath?: string;
}

const { lang, subpath = '' } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'ja' ? 'en' : 'ja';

const navItems = [
  { href: localePath(lang, 'about/'), label: t('nav.about') },
  { href: localePath(lang, 'schedule/'), label: t('nav.schedule') },
  { href: localePath(lang, 'media/'), label: t('nav.media') },
  { href: localePath(lang, 'contact/'), label: t('nav.contact') },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 bg-base/90 backdrop-blur border-b border-line">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a
      href={localePath(lang)}
      class="font-serif text-lg tracking-[0.2em] hover:text-accent transition-colors"
    >
      {lang === 'ja' ? SITE.artistNameJa : SITE.artistNameDisplay}
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link text-[0.8125rem] tracking-[0.18em] text-ink/80 hover:text-accent transition-colors"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={localePath(otherLang, subpath)}
        rel="alternate"
        hreflang={otherLang}
        class="text-xs tracking-widest text-muted hover:text-accent transition-colors border border-line rounded-full px-3 py-1"
      >
        {otherLang.toUpperCase()}
      </a>
      <a
        href={`${localePath(lang, 'contact/')}#booking`}
        class="btn-cta bg-accent hover:bg-accent-dark text-white text-sm tracking-widest px-5 py-2"
      >
        {t('nav.booking')}
      </a>
    </nav>

    <div class="flex items-center gap-3 md:hidden">
      <a
        href={localePath(otherLang, subpath)}
        rel="alternate"
        hreflang={otherLang}
        class="text-xs tracking-widest text-muted border border-line rounded-full px-3 py-1"
      >
        {otherLang.toUpperCase()}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex h-10 w-10 flex-col items-center justify-center gap-1.5"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-bar block h-px w-6 bg-ink transition-transform"></span>
        <span class="menu-bar block h-px w-6 bg-ink transition-opacity"></span>
        <span class="menu-bar block h-px w-6 bg-ink transition-transform"></span>
      </button>
    </div>
  </div>

  <!-- モバイル: 全画面オーバーレイメニュー（仕様書②-4） -->
  <div
    id="mobile-menu"
    class="fixed inset-0 top-16 z-40 flex flex-col items-center justify-center gap-8 bg-base md:hidden"
  >
    {
      navItems.map((item) => (
        <a href={item.href} class="font-serif text-2xl tracking-[0.3em] hover:text-accent">
          {item.label}
        </a>
      ))
    }
    <a
      href={`${localePath(lang, 'contact/')}#booking`}
      class="btn-cta bg-accent text-white tracking-widest px-8 py-3 mt-4"
    >
      {t('nav.booking')}
    </a>
  </div>
</header>

<!-- 固定ヘッダー分の余白 -->
<div class="h-16" aria-hidden="true"></div>

<script>
  // View Transitions でページが入れ替わるたびに再バインドする
  function bindMobileMenu() {
    const toggleButton = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    toggleButton?.addEventListener('click', () => {
      const isOpen = toggleButton.getAttribute('aria-expanded') === 'true';
      toggleButton.setAttribute('aria-expanded', String(!isOpen));
      // 表示/非表示は CSS の visibility/opacity 遷移（.is-open）で行う
      mobileMenu?.classList.toggle('is-open', !isOpen);
      document.body.classList.toggle('overflow-hidden', !isOpen);
    });

    // メニュー内のリンクを押したら閉じる（同一ページ内アンカー対策）
    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleButton?.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('is-open');
        document.body.classList.remove('overflow-hidden');
      });
    });
  }

  // スクロール時のみヘッダーに影を付ける
  const SCROLL_SHADOW_THRESHOLD_PX = 16;

  function updateHeaderShadow() {
    document
      .getElementById('site-header')
      ?.classList.toggle('is-scrolled', window.scrollY > SCROLL_SHADOW_THRESHOLD_PX);
  }

  window.addEventListener('scroll', updateHeaderShadow, { passive: true });

  document.addEventListener('astro:page-load', () => {
    bindMobileMenu();
    updateHeaderShadow(); // 遷移直後のスクロール位置に合わせて初期状態を反映
  });
</script>
