---
import { SITE } from '../config/site';
import { localePath } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  subpath?: string;
  /**
   * ページ冒頭が「夜の舞台」（ヒーロー／PageHero）で始まる場合 true。
   * ヘッダーは透過・和紙色文字で舞台に重なり、余白用のスペーサーを出さない。
   */
  overlay?: boolean;
}

const { lang, subpath = '', overlay = true } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'ja' ? 'en' : 'ja';

const navItems = [
  { sub: 'about/', en: 'About', label: t('nav.about') },
  { sub: 'schedule/', en: 'Schedule', label: t('nav.schedule') },
  { sub: 'media/', en: 'Media', label: t('nav.media') },
  { sub: 'contact/', en: 'Contact', label: t('nav.contact') },
].map((item) => ({
  ...item,
  href: localePath(lang, item.sub),
  current: subpath.startsWith(item.sub),
}));
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50"
  data-header-theme={overlay ? 'night' : 'day'}
>
  <div class="relative z-10 mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a
      id="site-logo"
      href={localePath(lang)}
      class="group flex items-center gap-2.5 font-serif text-base tracking-[0.14em] transition-opacity hover:opacity-75 sm:gap-3 sm:text-lg sm:tracking-[0.2em]"
    >
      <!-- 落款風の朱の小印 -->
      <span class="h-2 w-2 rotate-45 bg-vermilion" aria-hidden="true"></span>
      {lang === 'ja' ? SITE.artistNameJa : SITE.artistNameDisplay}
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label={t('nav.primary')}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link text-[0.8125rem] tracking-[0.18em] opacity-80 transition-opacity hover:opacity-100 aria-[current=page]:opacity-100"
            aria-current={item.current ? 'page' : undefined}
          >
            {/* ローリングテキスト: 同じラベルを2段重ねてホバーでスライド */}
            <span class="roll">
              <span class="roll-inner">
                <span>{item.label}</span>
                <span aria-hidden="true">{item.label}</span>
              </span>
            </span>
          </a>
        ))
      }
      <a
        href={localePath(otherLang, subpath)}
        rel="alternate"
        hreflang={otherLang}
        lang={otherLang}
        class="hud rounded-full border border-current/25 px-3 py-1 opacity-70 transition-opacity hover:opacity-100"
        aria-label={otherLang === 'en' ? 'English' : '日本語'}
      >
        {otherLang.toUpperCase()}
      </a>
      <a
        href={`${localePath(lang, 'contact/')}#booking`}
        class="btn-cta header-cta px-5 py-2 text-sm tracking-widest"
        data-magnetic
      >
        {t('nav.booking')}
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a
        id="header-lang"
        href={localePath(otherLang, subpath)}
        rel="alternate"
        hreflang={otherLang}
        lang={otherLang}
        class="hud flex h-10 items-center rounded-full border border-current/25 px-3 opacity-75 transition-opacity"
        aria-label={otherLang === 'en' ? 'English' : '日本語'}
      >
        {otherLang.toUpperCase()}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex h-11 w-11 flex-col items-center justify-center gap-1.5"
        aria-label={t('nav.menu')}
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-bar block h-px w-6 bg-current transition-all"></span>
        <span class="menu-bar block h-px w-6 bg-current transition-all"></span>
        <span class="menu-bar block h-px w-6 bg-current transition-all"></span>
      </button>
    </div>
  </div>

  <!-- モバイル: 夜の舞台の全画面メニュー。和文 + 欧文の二段組、現在地に朱の印 -->
  <div
    id="mobile-menu"
    class="theme-night night-sky fixed inset-0 z-0 flex flex-col justify-center gap-0 px-8 pt-16 md:hidden"
    data-theme="night"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="group flex items-baseline gap-5 border-b border-paper/10 py-4 text-paper/95 transition-colors hover:text-paper/60"
          aria-current={item.current ? 'page' : undefined}
        >
          <span class="flex flex-1 flex-col">
            <span class="font-serif text-2xl tracking-[0.2em]">{item.label}</span>
            {lang === 'ja' && <span class="hud mt-1 text-paper/40">{item.en}</span>}
          </span>
          {item.current && (
            <span class="h-2 w-2 self-center rotate-45 bg-vermilion" aria-hidden="true" />
          )}
        </a>
      ))
    }
    <div class="mt-10 flex items-center justify-between">
      <a
        href={localePath(otherLang, subpath)}
        rel="alternate"
        hreflang={otherLang}
        lang={otherLang}
        class="hud rounded-full border border-paper/30 px-4 py-2 text-paper/80 transition-colors hover:border-paper/60"
      >
        {otherLang === 'en' ? 'English' : '日本語'}
      </a>
      <a
        href={`${localePath(lang, 'contact/')}#booking`}
        class="btn-cta btn-light px-7 py-3 text-xs tracking-[0.25em]"
      >
        {t('nav.booking')}
      </a>
    </div>
    <div class="hud mt-10 flex items-center justify-between text-paper/35">
      {
        SITE.sns.instagram && (
          <a href={SITE.sns.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-paper">
            Instagram ↗
          </a>
        )
      }
      <span>{SITE.artistNameDisplay}</span>
    </div>
  </div>
</header>

{/* 冒頭が夜の舞台でないページ（ありがとう・404 等）のみ、固定ヘッダー分の余白を確保 */}
{!overlay && <div class="h-16" aria-hidden="true" />}

<script>
  let menuOpen = false;

  function setMenuOpen(open: boolean) {
    const toggleButton = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    menuOpen = open;
    toggleButton?.setAttribute('aria-expanded', String(open));
    toggleButton?.setAttribute(
      'aria-label',
      (open ? toggleButton.dataset.labelClose : toggleButton.dataset.labelOpen) ?? 'Menu'
    );
    // 表示/非表示は CSS の visibility/opacity 遷移（.is-open）で行う
    mobileMenu?.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('menu-open', open);
    if (open) {
      mobileMenu?.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    }
  }

  // View Transitions でページが入れ替わるたびに再バインドする
  function bindMobileMenu() {
    const toggleButton = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    // html は View Transitions を跨いで残るため、遷移直後は必ず閉じた状態に戻す
    setMenuOpen(false);

    toggleButton?.addEventListener('click', () => setMenuOpen(!menuOpen));

    // メニュー内のリンクを押したら閉じる（同一ページ内アンカー対策）
    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });
  }

  // 画面幅が PC に広がったら閉じる
  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });

  // Esc で閉じてトグルにフォーカスを戻す。Tab はメニュー内で循環させる（簡易フォーカストラップ）
  document.addEventListener('keydown', (event) => {
    if (!menuOpen) return;
    const toggleButton = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (event.key === 'Escape') {
      setMenuOpen(false);
      toggleButton?.focus();
      return;
    }
    if (event.key === 'Tab' && mobileMenu && toggleButton) {
      const focusables = [toggleButton, ...Array.from(mobileMenu.querySelectorAll<HTMLElement>('a'))];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });

  /**
   * ヘッダーの昼夜切替: ヘッダー中央の高さにある要素が「夜の舞台」（[data-theme="night"]）なら
   * 透過＋和紙色文字、それ以外は和紙の帯＋墨文字にする。スクロール時は影／すりガラスを付ける。
   */
  const SCROLL_SHADOW_THRESHOLD_PX = 16;
  const HEADER_PROBE_Y = 32;

  function updateHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > SCROLL_SHADOW_THRESHOLD_PX);
    let night = false;
    document.querySelectorAll<HTMLElement>('main [data-theme="night"], footer[data-theme="night"]').forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top <= HEADER_PROBE_Y && rect.bottom > HEADER_PROBE_Y) night = true;
    });
    header.dataset.headerTheme = night ? 'night' : 'day';
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('resize', updateHeader, { passive: true });

  document.addEventListener('astro:page-load', () => {
    bindMobileMenu();
    updateHeader(); // 遷移直後のスクロール位置に合わせて初期状態を反映
  });
</script>
