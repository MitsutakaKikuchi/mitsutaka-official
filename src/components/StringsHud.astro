---
/**
 * 光の三本弦に添える HUD。
 * - 三つの点: 弾かれた弦（一・二・三の糸）に対応して灯る
 * - 調弦名（本調子）
 * - 音のトグル（既定 OFF。押すと Web Audio で撥音を合成して鳴らす）
 * 親要素に [data-strings-host] があれば、その中の弦と同期する（JS: scripts/strings.ts）。
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 「弦に触れる」の案内文を出すか */
  hint?: boolean;
  class?: string;
}

const { lang, hint = true, class: className = '' } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={['hud flex flex-col gap-2 text-paper/55', className]}>
  <div class="flex items-center gap-3">
    <span class="flex items-center gap-1.5" aria-hidden="true">
      <span class="string-dot" data-string-dot data-dot="3"></span>
      <span class="string-dot" data-string-dot data-dot="2"></span>
      <span class="string-dot" data-string-dot data-dot="1"></span>
    </span>
    <span>{t('hero.tuning')}</span>
    <button
      type="button"
      class="inline-flex min-h-8 items-center gap-1.5 border border-paper/20 px-2 py-1 text-paper/70 transition-colors hover:border-paper/50 hover:text-paper aria-pressed:border-glow aria-pressed:text-glow"
      aria-pressed="false"
      aria-label={t('hero.soundLabel')}
      data-sound-toggle
      data-label-on={t('hero.soundOn')}
      data-label-off={t('hero.soundOff')}
    >
      <svg viewBox="0 0 16 16" class="h-3 w-3" aria-hidden="true">
        <path d="M2 6h3l4-3v10l-4-3H2z" fill="currentColor"></path>
        <path d="M11 5.5c1 1.4 1 3.6 0 5M13 3.5c2 2.6 2 6.4 0 9" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
      </svg>
      <span>{t('hero.sound')}</span>
      <span data-sound-label>{t('hero.soundOff')}</span>
    </button>
  </div>
  {hint && <p class="hidden text-paper/35 sm:block">— {t('hero.strings')}</p>}
</div>
