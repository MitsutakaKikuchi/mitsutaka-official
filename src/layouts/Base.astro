---
import '@fontsource-variable/inter';
import '@fontsource/italiana';
import '@fontsource/yuji-syuku';
import '@fontsource-variable/cormorant';
import '@fontsource-variable/noto-sans-jp';
import '@fontsource-variable/noto-serif-jp';
import '@fontsource/shippori-mincho-b1/500.css';
import '@fontsource/shippori-mincho-b1/700.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { SITE } from '../config/site';
import { localePath, withBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 言語プレフィックス以降のパス（例: 'about/'。トップは ''） */
  subpath?: string;
  title?: string;
  description?: string;
}

const { lang, subpath = '', title, description } = Astro.props;

const siteTitle = lang === 'ja' ? SITE.titleJa : SITE.titleEn;
const pageTitle = title ? `${title} | ${SITE.artistNameEn}` : siteTitle;
const pageDescription =
  description ?? (lang === 'ja' ? SITE.descriptionJa : SITE.descriptionEn);

const canonicalUrl = new URL(localePath(lang, subpath), Astro.site);
const jaUrl = new URL(localePath('ja', subpath), Astro.site);
const enUrl = new URL(localePath('en', subpath), Astro.site);

// 構造化データ: アーティスト情報（仕様書④-2）
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.artistNameEn,
  alternateName: SITE.artistNameJa,
  jobTitle: lang === 'ja' ? '長唄三味線方' : 'Nagauta Shamisen Player',
  description: lang === 'ja' ? SITE.descriptionJa : SITE.descriptionEn,
  url: new URL(withBase('/'), Astro.site).href,
  image: new URL(withBase('ogp.jpg'), Astro.site).href,
  nationality: lang === 'ja' ? '日本' : 'Japanese',
  knowsAbout:
    lang === 'ja'
      ? ['長唄', '三味線', '歌舞伎音楽', '日本の伝統音楽']
      : ['Nagauta', 'Shamisen', 'Kabuki music', 'Japanese traditional music'],
  sameAs: Object.values(SITE.sns).filter(Boolean),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE.artistNameEn} />
    <meta name="robots" content="index, follow" />
    {
      SITE.googleSiteVerification && (
        <meta name="google-site-verification" content={SITE.googleSiteVerification} />
      )
    }
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="ja" href={jaUrl.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="x-default" href={jaUrl.href} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={new URL(withBase('ogp.jpg'), Astro.site).href} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script is:inline>
      // JS 有効時のみフェードイン演出を適用するためのフラグ
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body class="bg-paper text-ink min-h-screen flex flex-col">
    <div id="scroll-progress" aria-hidden="true"></div>
    <Header lang={lang} subpath={subpath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <Lightbox lang={lang} />
    <script>
      // モーション演出一式（Lenis / GSAP / カーソル / WebGL パーティクル）
      import '../scripts/effects';
    </script>
  </body>
</html>
