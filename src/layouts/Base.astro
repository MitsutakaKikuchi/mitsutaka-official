---
import '@fontsource-variable/inter';
import '@fontsource/italiana';
import '@fontsource/yuji-syuku';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource-variable/cormorant';
import '@fontsource-variable/noto-sans-jp';
import '@fontsource-variable/noto-serif-jp';
import '@fontsource/shippori-mincho-b1/500.css';
import '@fontsource/shippori-mincho-b1/700.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import portraitPhoto from '../assets/photos/portrait.jpg';
import Intro from '../components/Intro.astro';
import { buildPerson, personId, websiteId } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import CookieBanner from '../components/CookieBanner.astro';
import StickyCta from '../components/StickyCta.astro';
import { SITE } from '../config/site';
import { localePath, withBase } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 言語プレフィックス以降のパス（例: 'about/'。トップは ''） */
  subpath?: string;
  /** ページ固有のメタタイトル。省略時はサイト全体のタイトル */
  title?: string;
  /** ページ固有のメタ記述。省略時はサイト全体の説明文 */
  description?: string;
  /** 検索エンジンに登録しないページ（ありがとうページ等） */
  noindex?: boolean;
  /** スマホのスティッキー CTA を出さない（お問い合わせページ等） */
  hideStickyCta?: boolean;
  /** OGP の種別（記事的なページは 'article'） */
  ogType?: 'website' | 'article';
  /**
   * ページ冒頭が「夜の舞台」（Hero / PageHero）で始まるか。
   * false のページ（ありがとう・404）はヘッダーを和紙色で表示し、余白を確保する
   */
  nightTop?: boolean;
  /** 開演演出（定式幕）を出すページか。トップページのみ true */
  intro?: boolean;
}

const {
  lang,
  subpath = '',
  title,
  description,
  noindex = false,
  hideStickyCta = false,
  ogType = 'website',
  nightTop = true,
  intro = false,
} = Astro.props;
const t = useTranslations(lang);

const siteTitle = lang === 'ja' ? SITE.titleJa : SITE.titleEn;
// 下層ページのタイトル末尾には職名も添える（「長唄 三味線」での検索にも名前が結び付くように）
const brand =
  lang === 'ja'
    ? `${SITE.artistNameJa}（長唄三味線方）`
    : `${SITE.artistNameEn}, Nagauta Shamisen Player`;
const pageTitle = title ? `${title} | ${brand}` : siteTitle;
const pageDescription =
  description ?? (lang === 'ja' ? SITE.descriptionJa : SITE.descriptionEn);

const canonicalUrl = new URL(localePath(lang, subpath), Astro.site);
const jaUrl = new URL(localePath('ja', subpath), Astro.site);
const enUrl = new URL(localePath('en', subpath), Astro.site);
const ogImageUrl = new URL(withBase(SITE.ogImage), Astro.site).href;
const ogImageAlt =
  lang === 'ja'
    ? `${SITE.artistNameJa} — 長唄三味線方 公式サイト`
    : `${SITE.artistNameEn} — Nagauta Shamisen Player, Official Website`;

// 構造化データ: アーティスト情報（仕様書④-2）。画像は OGP ではなく本人のポートレート
const portraitImage = await getImage({ src: portraitPhoto, width: 800, format: 'jpg' });
const portraitUrl = new URL(portraitImage.src, Astro.site).href;
const personJsonLd = {
  '@context': 'https://schema.org',
  ...buildPerson(lang, Astro.site, portraitUrl),
};

// 構造化データ: サイト自体（言語別 URL を明示し、運営者＝人物に結び付ける）
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId(Astro.site),
  name: siteTitle,
  url: new URL(localePath(lang), Astro.site).href,
  inLanguage: lang,
  publisher: { '@id': personId(Astro.site) },
  about: { '@id': personId(Astro.site) },
};
---

<!doctype html>
<html lang={lang} data-intro-page={intro ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE.artistNameEn} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content={nightTop ? '#0b0f16' : '#f7f5f0'} />
    {SITE.ga4MeasurementId && <meta name="ga4-measurement-id" content={SITE.ga4MeasurementId} />}
    {
      SITE.googleSiteVerification && (
        <meta name="google-site-verification" content={SITE.googleSiteVerification} />
      )
    }
    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="ja" href={jaUrl.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="x-default" href={jaUrl.href} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ja' ? 'en_US' : 'ja_JP'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline>
      // JS 有効時のみフェードイン演出を適用するためのフラグ
      document.documentElement.classList.add('js');
      // 開演演出（定式幕）: トップページへの初回訪問時のみ、描画前に判定して <html class="intro"> を付ける。
      // reduced-motion・クローラー・自動操作・ページ内遷移では出さない（?intro=1 で強制表示）
      (function () {
        try {
          var d = document.documentElement;
          if (!d.hasAttribute('data-intro-page') || document.readyState !== 'loading') return;
          var force = /[?&]intro=1(&|$)/.test(location.search);
          if (!force) {
            if (sessionStorage.getItem('mk-intro')) return;
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            if (navigator.webdriver) return;
            if (/bot|crawl|spider|slurp|lighthouse|headless|preview|facebookexternalhit/i.test(navigator.userAgent)) return;
          }
          sessionStorage.setItem('mk-intro', '1');
          window.__mkIntroT0 = performance.now();
          d.classList.add('intro');
          setTimeout(function () {
            d.classList.remove('intro', 'intro-skip');
          }, 2600);
        } catch (e) {
          /* sessionStorage が使えない環境では演出を出さない */
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-paper text-ink min-h-screen flex flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-ink focus:px-4 focus:py-2 focus:text-paper focus:text-sm focus:tracking-widest"
    >
      {lang === 'ja' ? '本文へスキップ' : 'Skip to content'}
    </a>
    {intro && <Intro />}
    <div id="scroll-progress" aria-hidden="true"></div>
    <!-- ページ遷移中の読み込みインジケーター（上部の藍→朱の線 + 右上の一円相） -->
    <div id="page-loader" aria-live="polite" aria-label={t('loading.label')} hidden>
      <span class="page-loader-bar" aria-hidden="true"></span>
      <svg class="page-loader-ensou" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></circle>
      </svg>
    </div>
    <Header lang={lang} subpath={subpath} overlay={nightTop} />
    <main id="content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    {!hideStickyCta && <StickyCta lang={lang} />}
    <Lightbox lang={lang} />
    <CookieBanner lang={lang} />
    <script>
      // モーション演出一式（Lenis / GSAP / カーソル / WebGL パーティクル）
      import '../scripts/effects';
      // 光の三本弦（触れると弾かれる弦・光の信号・文化譜の数字）
      import { initStrings } from '../scripts/strings';
      document.addEventListener('astro:page-load', initStrings);
      // 伝統 × 未来のモーショングラフィック（開演・筆の円相・墨→色・見出し・幕開き）
      import '../scripts/motion';
      // クッキー同意 + GA4（測定IDは <head> の meta から読む。View Transitions でも head は差し替わるため確実）
      import { initConsent } from '../scripts/consent';
      document.addEventListener('astro:page-load', () => {
        const meta = document.querySelector<HTMLMetaElement>('meta[name="ga4-measurement-id"]');
        initConsent(meta?.content ?? '');
      });
    </script>
  </body>
</html>
